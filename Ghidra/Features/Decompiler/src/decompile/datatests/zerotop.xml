void zerotop(float *out, const float *in, float s) {
  __m128 v = _mm_mul_ps(_mm_loadu_ps(in), _mm_set1_ps(s));
  __m128 t = _mm_shuffle_ps(v, _mm_setzero_ps(), 0x0a);
  v = _mm_shuffle_ps(v, t, 0x84);
  _mm_storeu_ps(out, v);
}
