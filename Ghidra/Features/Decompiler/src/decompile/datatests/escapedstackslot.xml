<!-- ARM Thumb code allocating locals with "push" instead of "sub sp" (GitHub issue #9728).
     The slot receiving a register from "push" is written and its address is passed to a
     sub-function, so it holds a local variable that must stay mapped and aliased.
     my_function:  push {r7,lr}; movs r0,#1; str r0,[sp,#0]; mov r0,sp; bl some_function; pop {r0,pc}
     my_function2: push {r2,r3,r7,lr}; movs r0,#1; str r0,[sp,#0]; mov r0,sp; add r1,sp,#4;
                   add r2,sp,#8; bl some_function; pop {r0,r1,r2,pc}
     my_function3: push {r5,r6,r7,lr}; mov r0,sp; bl some_function; add sp,#0xc; pop {pc}
     framefunc:    push {r7,lr}; add r7,sp,#0; bl some_function; nop; pop {r7,pc}
                   (genuine save of r7 followed by a frame pointer to its slot, must stay hidden)
-->
