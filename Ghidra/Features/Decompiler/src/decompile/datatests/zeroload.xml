<!--
#include <xmmintrin.h>
/* a vector loaded whole, its first lane stored alone (so the vector is known to have four-byte lanes), its top lane
   replaced by zero through two shuffles against a zero register, the result stored whole: the decompiler folds the
   shuffles into a zero extension of the low three lanes, which the lane split must follow forward from the loaded vector */
void zeroload(float *out, float *first, const float *in) {
  __m128 v = _mm_loadu_ps(in);
  _mm_store_ss(first, v);
  __m128 t = _mm_shuffle_ps(v, _mm_setzero_ps(), 0x0a);
  v = _mm_shuffle_ps(v, t, 0x84);
  _mm_storeu_ps(out, v);
}
