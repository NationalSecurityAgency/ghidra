# (v73,1) V6_get_qfext  --  "Vd32 = vgetqfext(Vu32.x,Rt32)"
#  _________________________________________________________________________________________________
#  |31|30|29|28|27|26|25|24|23|22|21|20|19|18|17|16|15|14|13|12|11|10|09|08|07|06|05|04|03|02|01|00|
#    0  0  0  1  1  0  0  1  1  1  0  t  t  t  t  t  P  P  0  u  u  u  u  u  1  1  1  d  d  d  d  d
:vgetqfext Vd5,VuX_0812,rx5 EndPacket  is iclass=1 & op2127=0x4e & op13=0 & op0507=0x7 & Vd5 & VuX_0812 & rx5 & $(END_PACKET) {
   Vd5 = v_vgetqfext_Vux_Rt(VuX_0812,rx5);
   build EndPacket;
}

# (v73,1) V6_get_qfext_oracc  --  "Vx32 |= vgetqfext(Vu32.x,Rt32)"
#  _________________________________________________________________________________________________
#  |31|30|29|28|27|26|25|24|23|22|21|20|19|18|17|16|15|14|13|12|11|10|09|08|07|06|05|04|03|02|01|00|
#    0  0  0  1  1  0  0  1  1  1  0  t  t  t  t  t  P  P  0  u  u  u  u  u  1  1  0  x  x  x  x  x
:vgetqfext|= Vd5,VuX_0812,rx5 EndPacket  is iclass=1 & op2127=0x4e & op13=0 & op0507=0x6 & vs5 & Vd5 & VuX_0812 & rx5 & $(END_PACKET) {
   Vd5 = v_vgetqfext_Vux_Rt_acc(vs5,VuX_0812,rx5);
   build EndPacket;
}

