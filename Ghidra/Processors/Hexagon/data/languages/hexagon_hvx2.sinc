# Qualcomm Hexagon HVX-v2 Instruction Set (V73 additions)
#
# V73 HVX "version 2" additions layered on the V69 HVX base in hexagon_hvx.sinc:
# IEEE/Qualcomm floating-point element ops (hf/sf/bf/f8), qf16/qf32 fixed-format
# conversions, and vrmpy(Rtt) reductions. Conventions follow hexagon_hvx.sinc
# (typed Vd/Vu/Vv lane wrappers, vs5/vss5 accumulate shadows, pcodeop stubs).
#
# NOTE: Quad-Vector support has been omitted
#
# Reuses hexagon.sinc / hexagon_hvx.sinc definitions; @include'd from hexagon.slaspec.

#
# Quad-Vector Operands (e.g., V0V3 )
# TODO: Addition of HVX-v2 quad-vector support has been deferred

# Quad-Vector destination unconditional write (2,4)
#Vdddd3: vdddd3  is cond=0 & vdddd3 & vdddd3_ {
#   export vdddd3_; # must be updated unconditionally
# <<COMMIT>>
#   vdddd3 =  vdddd3_;
#}

# source quad-vector (2,4) - read-only use
#Vssss_0004:vssss3  is vssss3 {
#	tmp:$(HVX_VECTOR_QUAD_SIZE) = vssss3;
#	export tmp;
#}

# Auto-generated HVX-v2 subtables
RtHF_1620: rx5^".hf"  is rx5 { tmp:4 = rx5; export tmp; }
RtSF_1620: rx5^".sf"  is rx5 { tmp:4 = rx5; export tmp; }
RttUB_1620: rxx5^".ub"  is rxx5 { tmp:8 = rxx5; export tmp; }
VdBF_0004: Vd5^".bf"  is Vd5 { export Vd5; }
VdF8_0004: Vd5^".f8"  is Vd5 { export Vd5; }
VdX_0004: Vd5^".x"  is Vd5 { export Vd5; }
VddHF_0004: Vdd5^".hf"  is Vdd5 { export Vdd5; }
VddQF16_0004: Vdd5^".qf16"  is Vdd5 { export Vdd5; }
VddSF_0004: Vdd5^".sf"  is Vdd5 { export Vdd5; }
VuBF_0812: Vu_0812^".bf"  is Vu_0812 { export Vu_0812; }
VuF8_0812: Vu_0812^".f8"  is Vu_0812 { export Vu_0812; }
VuX_0812: Vu_0812^".x"  is Vu_0812 { export Vu_0812; }
VvBF_1620: Vv_1620^".bf"  is Vv_1620 { export Vv_1620; }
VvF8_1620: Vv_1620^".f8"  is Vv_1620 { export Vv_1620; }

