:mv! rd16,ra16 is decode_phase=1 & p16=0 & op16=0 & func16=3 & rd16 & ra16 { rd16=ra16; }
:sll! rd16,ra16 is decode_phase=1 & p16=0 & op16=0 & func16=8 & rd16 & ra16 { local sh:4=ra16&31; rd16=rd16<<sh; }
:addc! rd16,ra16 is decode_phase=1 & p16=0 & op16=0 & func16=9 & rd16 & ra16 { local c:4=(cr1>>1)&1; rd16=rd16+ra16+c; }
