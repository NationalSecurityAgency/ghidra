:rte is decode_phase=1 & packet_half=0 & p_lo=1 & p_hi=1 & major32=6 & cr_op=0x84 {
    cr0 = (cr0 & 0xfffffffc) | ((cr0 >> 2) & 0x3);
    cr1 = (cr1 & 0xffffffe0) | ((cr1 >> 5) & 0x1f);
    return [cr5];
}

