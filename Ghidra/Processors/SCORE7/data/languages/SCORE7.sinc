:cmp! rd16,ra16 is decode_phase=1 & p16=0 & op16=2 & func16=3 & rd16 & ra16 { local result:4=rd16-ra16; score_set_sub_flags(rd16,ra16,result); }
:and! rd16,ra16 is decode_phase=1 & p16=0 & op16=2 & func16=4 & rd16 & ra16 { rd16=rd16&ra16; score_set_zn(rd16); }
