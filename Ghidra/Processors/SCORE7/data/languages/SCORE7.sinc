:sw rd32,ra32,SImm12 is decode_phase=1 & packet_half=0 & p_lo=1 & p_hi=1 & major32=7 & rix_func3=4 & rd32 & ra32 & SImm12 { local a:4=ra32 & 0xfffffffc; *:4 a=rd32; ra32=ra32+SImm12; }
