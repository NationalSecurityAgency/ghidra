# Sunplus S+CORE 7 / SCORE7
# Native Ghidra SLEIGH processor definition.
#
# Encoding and execution behavior were independently implemented from public
# architectural behavior. MAME's BSD-3-Clause little-endian SCORE7 core is the
# primary permissive behavioral reference; GNU binutils is an independent
# bi-endian encoding/decode oracle. Both force 16-bit decode when PC bit 1 is
# set, even if the following halfword would otherwise make a 32-bit/PCE marker
# pattern appear to match.
#
# SCORE7 uses 16-bit and 32-bit instructions. 32-bit instructions contain
# parity/length marker bits at physical bits 15 and 31; the logical 30-bit
# opcode omits those two bits.

define endian=$(ENDIAN);
define alignment=2;

define space ram type=ram_space size=4 wordsize=1 default;
define space register type=register_space size=4;

define register offset=0x000 size=4
[ r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 r16 r17 r18 r19 r20 r21 r22 r23 r24 r25 r26 r27 r28 r29 r30 r31 ];

# GCC SCORE ABI: r0 is the stack pointer, r2 the frame pointer, r3 the
# return-address/link register, and r28 the global pointer. Keep one physical
# varnode per architectural register; ABI roles live in SCORE7.cspec.

define register offset=0x100 size=4
[ cr0 cr1 cr2 cr3 cr4 cr5 cr6 cr7 cr8 cr9 cr10 cr11 cr12 cr13 cr14 cr15 cr16 cr17 cr18 cr19 cr20 cr21 cr22 cr23 cr24 cr25 cr26 cr27 cr28 cr29 cr30 cr31 ];

# Control registers remain canonical cr0..cr31. Known architectural roles
# include cr0=PSR, cr1=condition register, cr2=ECR, cr3=EXCPVEC,
# cr5=EPC, and cr6=EMA. Avoid duplicate alias varnodes for those roles.

define register offset=0x200 size=4 [ sr0 sr1 sr2 ];
define register offset=0x210 size=4 [ ceh cel ];
define register offset=0x300 size=4 pc;

# Transient decode context. SCORE7 fetches on 4-byte packet boundaries, but a
# compact instruction may execute from the upper halfword (PC & 2). In that
# position the architecture forces a 16-bit decode and must not read ahead into
# the next packet.
define register offset=0x304 size=4 score_context;
define context score_context
    decode_phase = (0,0) noflow
    packet_half  = (1,1) noflow
;


# System/custom operations whose architectural side effects are not modeled
# by the permissive reference implementation.
define pcodeop score_syscall;
define pcodeop score_trap;
define pcodeop score_debug_break;
define pcodeop score_pflush;
define pcodeop score_cache;
define pcodeop score_ceinst;
define pcodeop score_custom_engine;
define pcodeop score_rotate_flags;
define pcodeop score_rotate_carry;
define pcodeop score_pce;
define pcodeop score_parity_error;
define pcodeop score_atomic;
define pcodeop score_system;

# Physical 32-bit encoding. p_lo/p_hi are marker/parity bits and are not part
# of the logical 30-bit opcode.
define token score32(32)
    p_lo        = (15,15)
    p_hi        = (31,31)
    major32     = (26,30)
    rd32        = (21,25)
    ra32        = (16,20)
    rb32        = (10,14)
    special_pad = (7,9)
    trap_code   = (16,20)
    func6       = (1,6)
    cu          = (0,0)

    ifunc3      = (18,20)
    imm16_lo    = (1,14)
    imm16_hi    = (16,17)
    imm16_hi_s  = (16,17) signed

    ri_imm14    = (1,14)
    ri_imm14_s  = (1,14) signed

    jdisp_lo    = (1,14)
    jdisp_hi    = (16,25)

    bc_disp_lo  = (1,9)
    bc_disp_hi  = (16,25)
    bc_disp_hi_s= (16,25) signed
    bc_cond     = (10,14)

    rix_func3   = (0,2)
    rix_imm12   = (3,14) signed

    cr_op       = (0,7)
    cr_idx      = (16,20)

    ls_imm15    = (0,14) signed
    ls_imm15_u  = (0,14)

    pce_lo      = (0,14)
    pce_hi      = (16,30)
    ceinst_a     = (5,9)
    ceinst_b     = (0,4)
;

# Physical 16-bit encoding. Bit 15 is the SCORE parity/length marker.
define token score16(16)
    p16         = (15,15)
    op16        = (12,14)
    rd16        = (8,11)
    ra16        = (4,7)
    func16      = (0,3)

    j11         = (1,11)
    lk16        = (0,0)

    b8          = (0,7) signed
    cond16      = (8,11)

    imm8        = (0,7)
    i16_func3   = (0,2)
    imm5        = (3,7)
    imm4        = (3,6)
    imm_sign    = (7,7)

    preg_base   = (4,6)
    preg_hi     = (7,7)
    preg_lo     = (8,11)
;

attach variables [ rd32 ra32 rb32 ] [
    r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 r16 r17 r18 r19 r20 r21 r22 r23 r24 r25 r26 r27 r28 r29 r30 r31
];

attach variables [ cr_idx ] [
    cr0 cr1 cr2 cr3 cr4 cr5 cr6 cr7 cr8 cr9 cr10 cr11 cr12 cr13 cr14 cr15 cr16 cr17 cr18 cr19 cr20 cr21 cr22 cr23 cr24 cr25 cr26 cr27 cr28 cr29 cr30 cr31
];

attach variables [ rd16 ra16 ] [
    r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15
];

attach variables [ preg_base ] [
    r0 r1 r2 r3 r4 r5 r6 r7
];

# Fixed ABI return operands. Keep r3 as a real operand varnode so listings and
# structured MCP disassembly preserve the operand while the root constructor can
# still distinguish the ABI return idiom from a generic indirect branch.
ReturnReg32: r3 is ra32=3 & r3 { export r3; }
ReturnReg16: r3 is ra16=3 & r3 { export r3; }

SpecialReg: sr0 is rb32=0 & sr0 { export sr0; }
SpecialReg: sr1 is rb32=1 & sr1 { export sr1; }
SpecialReg: sr2 is rb32=2 & sr2 { export sr2; }

# ----- computed immediates / targets -----

SImm16: val is imm16_lo & imm16_hi_s
    [ val = (imm16_hi_s << 14) | imm16_lo; ]
    { export *[const]:4 val; }

UImm16: val is imm16_lo & imm16_hi
    [ val = (imm16_hi << 14) | imm16_lo; ]
    { export *[const]:4 val; }

SImm14: ri_imm14_s is ri_imm14_s
    { export *[const]:4 ri_imm14_s; }

UImm14: ri_imm14 is ri_imm14
    { export *[const]:4 ri_imm14; }

SImm12: rix_imm12 is rix_imm12
    { export *[const]:4 rix_imm12; }

SImm15: ls_imm15 is ls_imm15
    { export *[const]:4 ls_imm15; }

JTarget32: addr is jdisp_lo & jdisp_hi
    [ addr = (inst_start & 0xfe000000) | (((jdisp_hi << 14) | jdisp_lo) << 1); ]
    { export *:4 addr; }

BTarget32: addr is bc_disp_lo & bc_disp_hi_s
    [ addr = inst_start + (((bc_disp_hi_s << 9) | bc_disp_lo) << 1); ]
    { export *:4 addr; }

JTarget16: addr is j11
    [ addr = (inst_start & 0xfffff000) | (j11 << 1); ]
    { export *:4 addr; }

BTarget16: addr is b8
    [ addr = inst_start + (b8 << 1); ]
    { export *:4 addr; }

# 5-bit push/pop register is physically split across bit 7 and bits 8..11.
PReg: r0 is preg_hi=0 & preg_lo=0 & r0 { export r0; }
PReg: r1 is preg_hi=0 & preg_lo=1 & r1 { export r1; }
PReg: r2 is preg_hi=0 & preg_lo=2 & r2 { export r2; }
PReg: r3 is preg_hi=0 & preg_lo=3 & r3 { export r3; }
PReg: r4 is preg_hi=0 & preg_lo=4 & r4 { export r4; }
PReg: r5 is preg_hi=0 & preg_lo=5 & r5 { export r5; }
PReg: r6 is preg_hi=0 & preg_lo=6 & r6 { export r6; }
PReg: r7 is preg_hi=0 & preg_lo=7 & r7 { export r7; }
PReg: r8 is preg_hi=0 & preg_lo=8 & r8 { export r8; }
PReg: r9 is preg_hi=0 & preg_lo=9 & r9 { export r9; }
PReg: r10 is preg_hi=0 & preg_lo=10 & r10 { export r10; }
PReg: r11 is preg_hi=0 & preg_lo=11 & r11 { export r11; }
PReg: r12 is preg_hi=0 & preg_lo=12 & r12 { export r12; }
PReg: r13 is preg_hi=0 & preg_lo=13 & r13 { export r13; }
PReg: r14 is preg_hi=0 & preg_lo=14 & r14 { export r14; }
PReg: r15 is preg_hi=0 & preg_lo=15 & r15 { export r15; }
PReg: r16 is preg_hi=1 & preg_lo=0 & r16 { export r16; }
PReg: r17 is preg_hi=1 & preg_lo=1 & r17 { export r17; }
PReg: r18 is preg_hi=1 & preg_lo=2 & r18 { export r18; }
PReg: r19 is preg_hi=1 & preg_lo=3 & r19 { export r19; }
PReg: r20 is preg_hi=1 & preg_lo=4 & r20 { export r20; }
PReg: r21 is preg_hi=1 & preg_lo=5 & r21 { export r21; }
PReg: r22 is preg_hi=1 & preg_lo=6 & r22 { export r22; }
PReg: r23 is preg_hi=1 & preg_lo=7 & r23 { export r23; }
PReg: r24 is preg_hi=1 & preg_lo=8 & r24 { export r24; }
PReg: r25 is preg_hi=1 & preg_lo=9 & r25 { export r25; }
PReg: r26 is preg_hi=1 & preg_lo=10 & r26 { export r26; }
PReg: r27 is preg_hi=1 & preg_lo=11 & r27 { export r27; }
PReg: r28 is preg_hi=1 & preg_lo=12 & r28 { export r28; }
PReg: r29 is preg_hi=1 & preg_lo=13 & r29 { export r29; }
PReg: r30 is preg_hi=1 & preg_lo=14 & r30 { export r30; }
PReg: r31 is preg_hi=1 & preg_lo=15 & r31 { export r31; }


# High GPR bank used by mlfh!/mhfl!.
HighRA: r16 is ra16=0 & r16 { export r16; }
HighRA: r17 is ra16=1 & r17 { export r17; }
HighRA: r18 is ra16=2 & r18 { export r18; }
HighRA: r19 is ra16=3 & r19 { export r19; }
HighRA: r20 is ra16=4 & r20 { export r20; }
HighRA: r21 is ra16=5 & r21 { export r21; }
HighRA: r22 is ra16=6 & r22 { export r22; }
HighRA: r23 is ra16=7 & r23 { export r23; }
HighRA: r24 is ra16=8 & r24 { export r24; }
HighRA: r25 is ra16=9 & r25 { export r25; }
HighRA: r26 is ra16=10 & r26 { export r26; }
HighRA: r27 is ra16=11 & r27 { export r27; }
HighRA: r28 is ra16=12 & r28 { export r28; }
HighRA: r29 is ra16=13 & r29 { export r29; }
HighRA: r30 is ra16=14 & r30 { export r30; }
HighRA: r31 is ra16=15 & r31 { export r31; }
HighRD: r16 is rd16=0 & r16 { export r16; }
HighRD: r17 is rd16=1 & r17 { export r17; }
HighRD: r18 is rd16=2 & r18 { export r18; }
HighRD: r19 is rd16=3 & r19 { export r19; }
HighRD: r20 is rd16=4 & r20 { export r20; }
HighRD: r21 is rd16=5 & r21 { export r21; }
HighRD: r22 is rd16=6 & r22 { export r22; }
HighRD: r23 is rd16=7 & r23 { export r23; }
HighRD: r24 is rd16=8 & r24 { export r24; }
HighRD: r25 is rd16=9 & r25 { export r25; }
HighRD: r26 is rd16=10 & r26 { export r26; }
HighRD: r27 is rd16=11 & r27 { export r27; }
HighRD: r28 is rd16=12 & r28 { export r28; }
HighRD: r29 is rd16=13 & r29 { export r29; }
HighRD: r30 is rd16=14 & r30 { export r30; }
HighRD: r31 is rd16=15 & r31 { export r31; }

# ----- flag helpers -----
# cr1 low bits: V=bit0, C=bit1, Z=bit2, N=bit3, T=bit4.

macro score_set_zn(value) {
    local z:1 = (value == 0);
    local n:1 = (value s< 0);
    cr1 = cr1 & 0xfffffff3;
    cr1 = cr1 | (zext(z) << 2) | (zext(n) << 3);
}

macro score_set_add_flags(a,b,result) {
    local c:1 = carry(a,b);
    local v:1 = scarry(a,b);
    local z:1 = (result == 0);
    local n:1 = (result s< 0);
    cr1 = cr1 & 0xfffffff0;
    cr1 = cr1 | zext(v) | (zext(c) << 1) | (zext(z) << 2) | (zext(n) << 3);
}

macro score_set_sub_flags(a,b,result) {
    local c:1 = (a >= b);
    local v:1 = sborrow(a,b);
    local z:1 = (result == 0);
    local n:1 = (result s< 0);
    cr1 = cr1 & 0xfffffff0;
    cr1 = cr1 | zext(v) | (zext(c) << 1) | (zext(z) << 2) | (zext(n) << 3);
}

macro score_set_sub_zero_flags(a,result) {
    local v:1 = sborrow(a,0:4);
    local z:1 = (result == 0);
    local n:1 = (result s< 0);
    cr1 = cr1 & 0xfffffff0;
    cr1 = cr1 | zext(v) | 0x2 | (zext(z) << 2) | (zext(n) << 3);
}

macro score_set_neg_flags(b,result) {
    local c:1 = (b == 0);
    local v:1 = sborrow(0:4,b);
    local z:1 = (result == 0);
    local n:1 = (result s< 0);
    cr1 = cr1 & 0xfffffff0;
    cr1 = cr1 | zext(v) | (zext(c) << 1) | (zext(z) << 2) | (zext(n) << 3);
}

macro score_set_t(value) {
    local t:1 = (value != 0);
    cr1 = (cr1 & 0xffffffef) | (zext(t) << 4);
}

# Root wrapper: set transient address phase before recursively matching the real
# instruction constructor. This follows the phase-wrapper pattern used by
# bundled Ghidra languages (for example AVR) without introducing a new subtable.
:^instruction is decode_phase=0 & instruction
    [ packet_half = (inst_start >> 1) $and 1; decode_phase=1; ]
    { build instruction; }

# ----- parity / parallel encoding guards -----

@if ENDIAN == "little"
# GNU SCORE emits PCE as two little-endian halfwords in source order, rather
# than as one little-endian 32-bit word. Thus the marker bits appear swapped
# in the 32-bit token value compared with normal instructions.
:parity_error is decode_phase=1 & packet_half=0 & p_lo=1 & p_hi=0 {
    score_parity_error();
}

:pce pce_lo, pce_hi is decode_phase=1 & packet_half=0 & p_lo=0 & p_hi=1 & pce_lo & pce_hi {
    score_pce();
}
@else
# Big-endian PCE uses the architectural 32-bit halfword order directly.
:parity_error is decode_phase=1 & packet_half=0 & p_lo=0 & p_hi=1 {
    score_parity_error();
}

:pce pce_hi, pce_lo is decode_phase=1 & packet_half=0 & p_lo=1 & p_hi=0 & pce_lo & pce_hi {
    score_pce();
}
@endif

# ===========================================================================
# 32-bit instructions
# ===========================================================================

# Special form (major 0)
:nop is decode_phase=1 & packet_half=0 & p_lo=1 & p_hi=1 & major32=0 & special_pad=0 & func6=0 & cu=0 { }
:syscall rd32 is decode_phase=1 & packet_half=0 & p_lo=1 & p_hi=1 & major32=0 & special_pad=0 & func6=1 & rd32 { score_syscall(); }
:sdbbp ra32 is decode_phase=1 & packet_half=0 & p_lo=1 & p_hi=1 & major32=0 & special_pad=0 & func6=3 & ra32 { score_debug_break(); }
:pflush is decode_phase=1 & packet_half=0 & p_lo=1 & p_hi=1 & major32=0 & special_pad=0 & func6=5 { score_pflush(); }

:alw rd32,"["^ra32^"]" is decode_phase=1 & packet_half=0 & p_lo=1 & p_hi=1 & major32=0 & special_pad=0 & func6=6 & cu=0 & rd32 & ra32 { score_atomic(); }
:asw rd32,"["^ra32^"]" is decode_phase=1 & packet_half=0 & p_lo=1 & p_hi=1 & major32=0 & special_pad=0 & func6=7 & cu=0 & rd32 & ra32 { score_atomic(); }

:trapcs trap_code is decode_phase=1 & packet_half=0 & p_lo=1 & p_hi=1 & major32=0 & func6=2 & cu=0 & special_pad=0 & rb32=0 & trap_code { if ((cr1 & 0x2) == 0) goto <done>; score_trap(); <done> }
:trapcc trap_code is decode_phase=1 & packet_half=0 & p_lo=1 & p_hi=1 & major32=0 & func6=2 & cu=0 & special_pad=0 & rb32=1 & trap_code { if ((cr1 & 0x2) != 0) goto <done>; score_trap(); <done> }
:trapgtu trap_code is decode_phase=1 & packet_half=0 & p_lo=1 & p_hi=1 & major32=0 & func6=2 & cu=0 & special_pad=0 & rb32=2 & trap_code { if ((cr1 & 0x2) == 0) goto <done>; if ((cr1 & 0x4) != 0) goto <done>; score_trap(); <done> }
:trapleu trap_code is decode_phase=1 & packet_half=0 & p_lo=1 & p_hi=1 & major32=0 & func6=2 & cu=0 & special_pad=0 & rb32=3 & trap_code { if ((cr1 & 0x2) == 0) goto <take>; if ((cr1 & 0x4) != 0) goto <take>; goto <done>; <take> score_trap(); <done> }
:trapeq trap_code is decode_phase=1 & packet_half=0 & p_lo=1 & p_hi=1 & major32=0 & func6=2 & cu=0 & special_pad=0 & rb32=4 & trap_code { if ((cr1 & 0x4) == 0) goto <done>; score_trap(); <done> }
:trapne trap_code is decode_phase=1 & packet_half=0 & p_lo=1 & p_hi=1 & major32=0 & func6=2 & cu=0 & special_pad=0 & rb32=5 & trap_code { if ((cr1 & 0x4) != 0) goto <done>; score_trap(); <done> }
:trapgt trap_code is decode_phase=1 & packet_half=0 & p_lo=1 & p_hi=1 & major32=0 & func6=2 & cu=0 & special_pad=0 & rb32=6 & trap_code { if ((cr1 & 0x4) != 0) goto <done>; if ((cr1 & 0x8) != ((cr1 & 0x1) << 3)) goto <done>; score_trap(); <done> }
:traple trap_code is decode_phase=1 & packet_half=0 & p_lo=1 & p_hi=1 & major32=0 & func6=2 & cu=0 & special_pad=0 & rb32=7 & trap_code { if ((cr1 & 0x4) != 0) goto <take>; if ((cr1 & 0x8) != ((cr1 & 0x1) << 3)) goto <take>; goto <done>; <take> score_trap(); <done> }
:trapge trap_code is decode_phase=1 & packet_half=0 & p_lo=1 & p_hi=1 & major32=0 & func6=2 & cu=0 & special_pad=0 & rb32=8 & trap_code { if ((cr1 & 0x8) != ((cr1 & 0x1) << 3)) goto <done>; score_trap(); <done> }
:traplt trap_code is decode_phase=1 & packet_half=0 & p_lo=1 & p_hi=1 & major32=0 & func6=2 & cu=0 & special_pad=0 & rb32=9 & trap_code { if ((cr1 & 0x8) == ((cr1 & 0x1) << 3)) goto <done>; score_trap(); <done> }
:trapmi trap_code is decode_phase=1 & packet_half=0 & p_lo=1 & p_hi=1 & major32=0 & func6=2 & cu=0 & special_pad=0 & rb32=10 & trap_code { if ((cr1 & 0x8) == 0) goto <done>; score_trap(); <done> }
:trappl trap_code is decode_phase=1 & packet_half=0 & p_lo=1 & p_hi=1 & major32=0 & func6=2 & cu=0 & special_pad=0 & rb32=11 & trap_code { if ((cr1 & 0x8) != 0) goto <done>; score_trap(); <done> }
:trapvs trap_code is decode_phase=1 & packet_half=0 & p_lo=1 & p_hi=1 & major32=0 & func6=2 & cu=0 & special_pad=0 & rb32=12 & trap_code { if ((cr1 & 0x1) == 0) goto <done>; score_trap(); <done> }
:trapvc trap_code is decode_phase=1 & packet_half=0 & p_lo=1 & p_hi=1 & major32=0 & func6=2 & cu=0 & special_pad=0 & rb32=13 & trap_code { if ((cr1 & 0x1) != 0) goto <done>; score_trap(); <done> }
:trap trap_code is decode_phase=1 & packet_half=0 & p_lo=1 & p_hi=1 & major32=0 & func6=2 & cu=0 & special_pad=0 & rb32=15 & trap_code { score_trap(); }


:add rd32,ra32,rb32 is decode_phase=1 & packet_half=0 & p_lo=1 & p_hi=1 & major32=0 & special_pad=0 & func6=8 & cu=0 & rd32 & ra32 & rb32 {
    rd32 = ra32 + rb32;
}
:add.c rd32,ra32,rb32 is decode_phase=1 & packet_half=0 & p_lo=1 & p_hi=1 & major32=0 & special_pad=0 & func6=8 & cu=1 & rd32 & ra32 & rb32 {
    local result:4 = ra32 + rb32;
    score_set_add_flags(ra32,rb32,result);
    rd32 = result;
}
:addc rd32,ra32,rb32 is decode_phase=1 & packet_half=0 & p_lo=1 & p_hi=1 & major32=0 & special_pad=0 & func6=9 & cu=0 & rd32 & ra32 & rb32 {
    local c:4 = (cr1 >> 1) & 1;
    rd32 = ra32 + rb32 + c;
}
:addc.c rd32,ra32,rb32 is decode_phase=1 & packet_half=0 & p_lo=1 & p_hi=1 & major32=0 & special_pad=0 & func6=9 & cu=1 & rd32 & ra32 & rb32 {
    local c:4 = (cr1 >> 1) & 1;
    local op2:4 = rb32 + c;
    local result:4 = ra32 + op2;
    score_set_add_flags(ra32,op2,result);
    rd32 = result;
}
:sub rd32,ra32,rb32 is decode_phase=1 & packet_half=0 & p_lo=1 & p_hi=1 & major32=0 & special_pad=0 & func6=10 & cu=0 & rd32 & ra32 & rb32 {
    rd32 = ra32 - rb32;
}
:sub.c rd32,ra32,rb32 is decode_phase=1 & packet_half=0 & p_lo=1 & p_hi=1 & major32=0 & special_pad=0 & func6=10 & cu=1 & rd32 & ra32 & rb32 {
    local result:4 = ra32 - rb32;
    score_set_sub_flags(ra32,rb32,result);
    rd32 = result;
}
:subc rd32,ra32,rb32 is decode_phase=1 & packet_half=0 & p_lo=1 & p_hi=1 & major32=0 & special_pad=0 & func6=11 & cu=0 & rd32 & ra32 & rb32 {
    local c:4 = (cr1 >> 1) & 1;
    rd32 = ra32 - rb32 - (1-c);
}
:subc.c rd32,ra32,rb32 is decode_phase=1 & packet_half=0 & p_lo=1 & p_hi=1 & major32=0 & special_pad=0 & func6=11 & cu=1 & rd32 & ra32 & rb32 {
    local c:4 = (cr1 >> 1) & 1;
    local borrow:4 = 1-c;
    local op1:4 = ra32-borrow;
    local result:4 = op1-rb32;
    score_set_sub_flags(op1,rb32,result);
    rd32=result;
}
:cmpteq.c ra32,rb32 is decode_phase=1 & packet_half=0 & p_lo=1 & p_hi=1 & major32=0 & special_pad=0 & func6=12 & cu=1 & rd32=0 & ra32 & rb32 {
    local result:4=ra32-rb32;
    score_set_sub_flags(ra32,rb32,result);
    score_set_t(result==0);
}
:cmptmi.c ra32,rb32 is decode_phase=1 & packet_half=0 & p_lo=1 & p_hi=1 & major32=0 & special_pad=0 & func6=12 & cu=1 & rd32=1 & ra32 & rb32 {
    local result:4=ra32-rb32;
    score_set_sub_flags(ra32,rb32,result);
    score_set_t(result s< 0);
