:EFDR ra,rb is op8=0xDB & ra & ra1 & ra2 & rb & rb1 & rb2 {
	local o:6 = ((zext(rb) << 32) | (zext(rb1) << 16) | zext(rb2));
	local v:6 = ((zext(ra) << 32) | (zext(ra1) << 16) | zext(ra2));
	local r:6 = efdiv(v, o);
	ra = r(4);
