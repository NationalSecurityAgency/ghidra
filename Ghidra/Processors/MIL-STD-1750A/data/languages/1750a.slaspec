}

:FCR ra,rb is op8=0xF9 & ra & ra1 & rb & rb1 {
	local o:4 = ((zext(rb) << 16) | zext(rb1));
	local v:4 = ((zext(ra) << 16) | zext(ra1));
	local r:1 = fcmp(v, o);
	CS_C = 0;
	CS_Z = r == 0;
	CS_N = r s< 0;
	CS_P = r s> 0;
}

:FC ra,DA is (op8=0xF8 & ra & ra1) ... & DA {
	local o:4 = *[ram]:4 DA;
	local v:4 = ((zext(ra) << 16) | zext(ra1));
	local r:1 = fcmp(v, o);
	CS_C = 0;
	CS_Z = r == 0;
	CS_N = r s< 0;
	CS_P = r s> 0;
}

:FCB BA is op6=0x0F & BA {
	local o:4 = *[ram]:4 BA;
