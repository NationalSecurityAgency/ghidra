:EFCR ra,rb is op8=0xFB & ra & ra1 & ra2 & rb & rb1 & rb2 {
	local o:6 = ((zext(rb) << 32) | (zext(rb1) << 16) | zext(rb2));
	local v:6 = ((zext(ra) << 32) | (zext(ra1) << 16) | zext(ra2));
	local r:1 = efcmp(v, o);
	CS_C = 0;
	CS_Z = r == 0;
	CS_N = r s< 0;
	CS_P = r s> 0;
}

:EFC ra,DA is (op8=0xFA & ra & ra1 & ra2) ... & DA {
	local o:6 = *[ram]:6 DA;
	local v:6 = ((zext(ra) << 32) | (zext(ra1) << 16) | zext(ra2));
	local r:1 = efcmp(v, o);
	CS_C = 0;
	CS_Z = r == 0;
	CS_N = r s< 0;
	CS_P = r s> 0;
}

:ST ra,DA is (op8=0x90 & ra & ra1) ... & DA {
	*[ram]:2 DA = ra;
}
:STI ra,IA is (op8=0x94 & ra & ra1) ... & IA {
	*[ram]:2 IA = ra;
}
:STB BA is op6=0x02 & BA {
	*[ram]:2 BA = R2;
}
:STBX BXA is op6=0x10 & opx=0x2 & BXA {
	*[ram]:2 BXA = R2;
}

:DST ra,DA is (op8=0x96 & ra & ra1) ... & DA {
	*[ram]:4 DA = ((zext(ra) << 16) | zext(ra1));
}
:DSTI ra,IA is (op8=0x98 & ra & ra1) ... & IA {
	*[ram]:4 IA = ((zext(ra) << 16) | zext(ra1));
}
:DSTB BA is op6=0x03 & BA {
	*[ram]:4 BA = ((zext(R0) << 16) | zext(R1));
}
:DSTX BXA is op6=0x10 & opx=0x3 & BXA {
	*[ram]:4 BXA = ((zext(R0) << 16) | zext(R1));
}


# Extended precision floating point load and store
:EFL ra,DA is (op8=0x8A & ra & ra1 & ra2) ... & DA {
	local v:6 = *[ram]:6 DA;
	ra = v(4);
	ra1 = v(2);
	ra2 = v:2;
	fcs(v);
}
:EFST ra,DA is (op8=0x9A & ra & ra1 & ra2) ... & DA {
	*[ram]:6 DA = (zext(ra) << 32) | (zext(ra1) << 16) | zext(ra2);
}

# Store a non-negative constant
:STZ DA is (op8=0x91 & n4=0) ... & DA      { *[ram]:2 DA = 0:2; }
:STC n4,DA is (op8=0x91 & n4) ... & DA     { local c:2 = n4; *[ram]:2 DA = c; }
:STZI IA is (op8=0x92 & n4=0) ... & IA     { *[ram]:2 IA = 0:2; }
:STCI n4,IA is (op8=0x92 & n4) ... & IA    { local c:2 = n4; *[ram]:2 IA = c; }

# Store register through mask, (RA+1) = mask
:SRM ra,DA is (op8=0x97 & ra & ra1) ... & DA {
	local a:2 = DA;
	*[ram]:2 a = (*[ram]:2 a & ~ra1) | (ra & ra1);
}

# Byte loads and stores; bits 0-7 are the upper byte
:LUB ra,DA is (op8=0x8B & ra) ... & DA   { ra = (ra & 0xff00) | (*[ram]:2 DA >> 8); cs(ra); }
:LUBI ra,IA is (op8=0x8D & ra) ... & IA  { ra = (ra & 0xff00) | (*[ram]:2 IA >> 8); cs(ra); }
:LLB ra,DA is (op8=0x8C & ra) ... & DA   { ra = (ra & 0xff00) | (*[ram]:2 DA & 0xff); cs(ra); }
:LLBI ra,IA is (op8=0x8E & ra) ... & IA  { ra = (ra & 0xff00) | (*[ram]:2 IA & 0xff); cs(ra); }
:STUB ra,DA is (op8=0x9B & ra) ... & DA  { local a:2 = DA; *[ram]:2 a = (*[ram]:2 a & 0xff) | (ra << 8); }
:SUBI ra,IA is (op8=0x9D & ra) ... & IA  { local a:2 = IA; *[ram]:2 a = (*[ram]:2 a & 0xff) | (ra << 8); }
:STLB ra,DA is (op8=0x9C & ra) ... & DA  { local a:2 = DA; *[ram]:2 a = (*[ram]:2 a & 0xff00) | (ra & 0xff); }
:SLBI ra,IA is (op8=0x9E & ra) ... & IA  { local a:2 = IA; *[ram]:2 a = (*[ram]:2 a & 0xff00) | (ra & 0xff); }

# Move multiple words, memory to memory: RA destination, RB source, RA+1 count
:MOV ra,rb is op8=0x93 & ra & ra1 & rb {
<loop>
	if (ra1 == 0) goto <done>;
	*[ram]:2 ra = *[ram]:2 rb;
	ra = ra + 1;
	rb = rb + 1;
	ra1 = ra1 - 1;
	goto <loop>;
<done>
}

# Increment and decrement memory by a positive integer
:INCM NP,DA is (op8=0xA3 & NP) ... & DA {
	local a:2 = DA;
	local v:2 = *[ram]:2 a;
	ovf(scarry(v, NP));
	CS_C = carry(v, NP);
	v = v + NP;
	*[ram]:2 a = v;
	nzp(v);
}
:DECM NP,DA is (op8=0xB3 & NP) ... & DA {
	local a:2 = DA;
	local v:2 = *[ram]:2 a;
	ovf(sborrow(v, NP));
	CS_C = v >= NP;
	v = v - NP;
	*[ram]:2 a = v;
	nzp(v);
}

# Absolute value and negate
:ABS ra,rb is op8=0xA4 & ra & rb {
	local o:2 = rb;
	ovf(o == 0x8000);
	local s:2 = zext(o s< 0);
	ra = (o ^ -s) + s;
	cs(ra);
}
:NEG ra,rb is op8=0xB4 & ra & rb   { ovf(rb == 0x8000); ra = -rb; cs(ra); }
:DABS ra,rb is op8=0xA5 & ra & ra1 & rb & rb1 {
	local o:4 = (zext(rb) << 16) | zext(rb1);
	ovf(o == 0x80000000);
	local s:4 = zext(o s< 0);
	local r:4 = (o ^ -s) + s;
	ra = r(2);
	ra1 = r:2;
	cs(r);
}
:DNEG ra,rb is op8=0xB5 & ra & ra1 & rb & rb1 {
	local o:4 = (zext(rb) << 16) | zext(rb1);
	ovf(o == 0x80000000);
	local r:4 = -o;
	ra = r(2);
	ra1 = r:2;
	cs(r);
}
:FABS ra,rb is op8=0xAC & ra & ra1 & rb & rb1 {
	local o:4 = (zext(rb) << 16) | zext(rb1);
	local r:4 = fabs(o);
	ra = r(2);
	ra1 = r:2;
	fcs(r);
}
:FNEG ra,rb is op8=0xBC & ra & ra1 & rb & rb1 {
	local o:4 = (zext(rb) << 16) | zext(rb1);
	local r:4 = fneg(o);
	ra = r(2);
	ra1 = r:2;
	fcs(r);
}

# Conversions
:FIX ra,rb is op8=0xE8 & ra & rb & rb1 {
	local e:1 = rb1:1;
	ovf(e s> 0x0f);
	if (e s> 0x0f) goto inst_next;
	local o:4 = (zext(rb) << 16) | zext(rb1);
	ra = fix(o);
	cs(ra);
}
:FLT ra,rb is op8=0xE9 & ra & ra1 & rb         { local r:4 = flt(rb); ra = r(2); ra1 = r:2; fcs(r); }
:EFIX ra,rb is op8=0xEA & ra & ra1 & rb & rb1 & rb2 {
	local e:1 = rb1:1;
	ovf(e s> 0x1f);
	if (e s> 0x1f) goto inst_next;
	local o:6 = (zext(rb) << 32) | (zext(rb1) << 16) | zext(rb2);
	local r:4 = efix(o);
	ra = r(2);
	ra1 = r:2;
	cs(r);
}
:EFLT ra,rb is op8=0xEB & ra & ra1 & ra2 & rb & rb1 {
	local o:4 = (zext(rb) << 16) | zext(rb1);
	local r:6 = eflt(o);
	ra = r(4);
	ra1 = r(2);
	ra2 = r:2;
	fcs(r);
}

# Exchange bytes, exchange words
:XBR ra is op8=0xEC & ra & rb=0     { ra = (ra << 8) | (ra >> 8); cs(ra); }
:XWR ra,rb is op8=0xED & ra & rb    { local t:2 = ra; ra = rb; rb = t; cs(ra); }

# Compare between limits: DO1 = [DA], DO2 = [DA+1]
:CBL ra,DA is (op8=0xF4 & ra) ... & DA {
	local a:2 = DA;
	local lo:2 = *[ram]:2 a;
	local hi:2 = *[ram]:2 (a + 1);
	CS_C = lo s> hi;
	CS_N = !CS_C && (ra s< lo);
	CS_P = !CS_C && (ra s> hi);
	CS_Z = !CS_C && !CS_N && !CS_P;
}

# Shifts, count N in the instruction (field holds N-1)
:SLL rb,NP is op8=0x60 & rb & NP    { rb = rb << NP; cs(rb); }
:SRL rb,NP is op8=0x61 & rb & NP    { rb = rb >> NP; cs(rb); }
:SRA rb,NP is op8=0x62 & rb & NP    { rb = rb s>> NP; cs(rb); }
:SLC rb,NP is op8=0x63 & rb & NP    { rb = (rb << NP) | (rb >> (16 - NP)); cs(rb); }
:DSLL rb,NP is op8=0x65 & rb & rb1 & NP {
	local v:4 = ((zext(rb) << 16) | zext(rb1)) << NP;
	rb = v(2); rb1 = v:2; cs(v);
}
:DSRL rb,NP is op8=0x66 & rb & rb1 & NP {
	local v:4 = ((zext(rb) << 16) | zext(rb1)) >> NP;
	rb = v(2); rb1 = v:2; cs(v);
}
:DSRA rb,NP is op8=0x67 & rb & rb1 & NP {
	local v:4 = ((zext(rb) << 16) | zext(rb1)) s>> NP;
	rb = v(2); rb1 = v:2; cs(v);
}
:DSLC rb,NP is op8=0x68 & rb & rb1 & NP {
	local o:4 = (zext(rb) << 16) | zext(rb1);
	local v:4 = (o << NP) | (o >> (32 - NP));
	rb = v(2); rb1 = v:2; cs(v);
}

# Shifts, count in register RB: positive shifts left, negative shifts right.
# A count outside -16..16 (-32..32 for double shifts) is a fixed point overflow and no shift.
:SLR ra,rb is op8=0x6A & ra & rb {
	local n:2 = rb;
	ovf((n s> 16) || (n s< -16));
	if ((n s> 16) || (n s< -16)) goto inst_next;
	ra = (ra << n) * zext(n s>= 0) + (ra >> -n) * zext(n s< 0);
	cs(ra);
}
:SAR ra,rb is op8=0x6B & ra & rb {
	local n:2 = rb;
	ovf((n s> 16) || (n s< -16));
	if ((n s> 16) || (n s< -16)) goto inst_next;
	ovf((n s> 0) && (((ra << n) s>> n) != ra));
	ra = (ra << n) * zext(n s>= 0) + (ra s>> -n) * zext(n s< 0);
	cs(ra);
}
:SCR ra,rb is op8=0x6C & ra & rb {
	ovf((rb s> 16) || (rb s< -16));
	if ((rb s> 16) || (rb s< -16)) goto inst_next;
	local n:2 = rb & 0xf;
	ra = (ra << n) | (ra >> (16 - n));
	cs(ra);
}
:DSLR ra,rb is op8=0x6D & ra & ra1 & rb {
	local n:4 = sext(rb);
	ovf((n s> 32) || (n s< -32));
	if ((n s> 32) || (n s< -32)) goto inst_next;
	local o:4 = (zext(ra) << 16) | zext(ra1);
	local v:4 = (o << n) * zext(n s>= 0) + (o >> -n) * zext(n s< 0);
	ra = v(2); ra1 = v:2; cs(v);
}
:DSAR ra,rb is op8=0x6E & ra & ra1 & rb {
	local n:4 = sext(rb);
	ovf((n s> 32) || (n s< -32));
	if ((n s> 32) || (n s< -32)) goto inst_next;
	local o:4 = (zext(ra) << 16) | zext(ra1);
	ovf((n s> 0) && (((o << n) s>> n) != o));
	local v:4 = (o << n) * zext(n s>= 0) + (o s>> -n) * zext(n s< 0);
	ra = v(2); ra1 = v:2; cs(v);
}
:DSCR ra,rb is op8=0x6F & ra & ra1 & rb {
	ovf((rb s> 32) || (rb s< -32));
	if ((rb s> 32) || (rb s< -32)) goto inst_next;
	local n:4 = sext(rb) & 0x1f;
	local o:4 = (zext(ra) << 16) | zext(ra1);
	local v:4 = (o << n) | (o >> (32 - n));
	ra = v(2); ra1 = v:2; cs(v);
}

# Bit operations; bit N counts from the MSB
:SBR n4,rb is op8=0x51 & n4 & rb & BIT      { rb = rb | BIT; }
:SB n4,DA is (op8=0x50 & n4 & BIT) ... & DA   { local a:2 = DA; *[ram]:2 a = *[ram]:2 a | BIT; }
:SBI n4,IA is (op8=0x52 & n4 & BIT) ... & IA  { local a:2 = IA; *[ram]:2 a = *[ram]:2 a | BIT; }
:RBR n4,rb is op8=0x54 & n4 & rb & BIT      { rb = rb & ~BIT; }
:RB n4,DA is (op8=0x53 & n4 & BIT) ... & DA   { local a:2 = DA; *[ram]:2 a = *[ram]:2 a & ~BIT; }
:RBI n4,IA is (op8=0x55 & n4 & BIT) ... & IA  { local a:2 = IA; *[ram]:2 a = *[ram]:2 a & ~BIT; }

macro testbit(v, m) {
	local b:1 = (v & m) != 0;
	CS_C = 0;
	CS_Z = !b;
	CS_N = b && (m == 0x8000);
	CS_P = b && (m != 0x8000);
}

:TBR n4,rb is op8=0x57 & n4 & rb & BIT      { testbit(rb, BIT); }
:TB n4,DA is (op8=0x56 & n4 & BIT) ... & DA   { testbit(*[ram]:2 DA, BIT); }
:TBI n4,IA is (op8=0x58 & n4 & BIT) ... & IA  { testbit(*[ram]:2 IA, BIT); }
:TSB n4,DA is (op8=0x59 & n4 & BIT) ... & DA  {
	local a:2 = DA;
	local v:2 = *[ram]:2 a;
	testbit(v, BIT);
	*[ram]:2 a = v | BIT;
}
:SVBR ra,rb is op8=0x5A & ra & rb    { rb = rb | (0x8000 >> (ra & 0xf)); }
:RVBR ra,rb is op8=0x5C & ra & rb    { rb = rb & ~(0x8000 >> (ra & 0xf)); }
:TVBR ra,rb is op8=0x5E & ra & rb    { local m:2 = 0x8000 >> (ra & 0xf); testbit(rb, m); }

# Branches, instruction counter relative
:BR REL  is op8=0x74 & REL  { goto REL; }
:BEZ REL is op8=0x75 & REL  { if (CS_Z) goto REL; }
:BLT REL is op8=0x76 & REL  { if (CS_N) goto REL; }
:BLE REL is op8=0x78 & REL  { if (CS_N || CS_Z) goto REL; }
:BGT REL is op8=0x79 & REL  { if (CS_P) goto REL; }
:BNZ REL is op8=0x7A & REL  { if (!CS_Z) goto REL; }
:BGE REL is op8=0x7B & REL  { if (CS_P || CS_Z) goto REL; }

# Jump on condition
:JC cc,JD is (op8=0x70 & cc & COND) ... & JD   { if (COND) goto JD; }
:JC cc,JX is (op8=0x70 & cc & COND) ... & JX   { local t:2 = JX; if (!COND) goto inst_next; goto [t]; }
# Unconditional indexed jump from location zero: the return from JS (5.25)
:JC cc,addr16,rx is (op8=0x70 & cc & ccv=7 & rx) ; addr16 & addrv=0  { return [rx]; }
:JC cc,addr16,rx is (op8=0x70 & cc & ccv=15 & rx) ; addr16 & addrv=0 { return [rx]; }
:JCI cc,IA is (op8=0x71 & cc & COND) ... & IA  { local t:2 = IA; if (!COND) goto inst_next; goto [t]; }

# Jump to subroutine, return address in RA
:JS ra,JD is (op8=0x72 & ra & NEXT) ... & JD   { ra = NEXT; call JD; }
:JS ra,JX is (op8=0x72 & ra & NEXT) ... & JX   { local t:2 = JX; ra = NEXT; call [t]; }

# Subtract one and jump
:SOJ ra,JD is (op8=0x73 & ra) ... & JD  { ra = ra - 1; cs(ra); if (ra != 0) goto JD; }
:SOJ ra,JX is (op8=0x73 & ra) ... & JX  { local t:2 = JX; ra = ra - 1; cs(ra); if (ra == 0) goto inst_next; goto [t]; }

# Stack IC and jump to subroutine, unstack IC and return
:SJS ra,JD is (op8=0x7E & ra & NEXT) ... & JD  { ra = ra - 1; *[ram]:2 ra = NEXT; call JD; }
:SJS ra,JX is (op8=0x7E & ra & NEXT) ... & JX  { local t:2 = JX; ra = ra - 1; *[ram]:2 ra = NEXT; call [t]; }
:URS ra is op8=0x7F & ra & rb=0         { local t:2 = *[ram]:2 ra; ra = ra + 1; return [t]; }

# Load status: (MK, SW, IC) <-- [DA, DA+1, DA+2]
:LST DA is (op8=0x7D & n4=0) ... & DA {
	local a:2 = DA;
	local m:2 = *[ram]:2 a;
	local s:2 = *[ram]:2 (a + 1);
	local t:2 = *[ram]:2 (a + 2);
	MK = m;
	SW = s;
	swtocs();
	return [t];
}
:LSTI IA is (op8=0x7C & n4=0) ... & IA {
	local a:2 = IA;
	local m:2 = *[ram]:2 a;
	local s:2 = *[ram]:2 (a + 1);
	local t:2 = *[ram]:2 (a + 2);
	MK = m;
	SW = s;
	swtocs();
	return [t];
}

# Branch to executive
:BEX nlo is op8=0x77 & n4=0 & nlo  { bex(nlo:1); }

# Input/output (5.1). Mandatory commands that act on the processor registers are modeled;
# other commands are named and use the xio_out/xio_in pcodeops. Commands w/ bit 0 (the MSB) set are input.
:XIO ra,"SMK" is op8=0x48 & ra & rx=0 ; xcmd=0x2000   { MK = ra; }
:XIO ra,"CLIR" is op8=0x48 & ra & rx=0 ; xcmd=0x2001  { PI = 0; FT = 0; }
:XIO ra,"ENBL" is op8=0x48 & ra & rx=0 ; xcmd=0x2002  { enable_interrupts(); }
:XIO ra,"DSBL" is op8=0x48 & ra & rx=0 ; xcmd=0x2003  { disable_interrupts(); }
:XIO ra,"RPI" is op8=0x48 & ra & rx=0 ; xcmd=0x2004 {
	local n:2 = ra & 0xf;
	PI = PI & ~(0x8000 >> n);
	FT = FT * zext(n != 1);
}
:XIO ra,"SPI" is op8=0x48 & ra & rx=0 ; xcmd=0x2005   { PI = PI | ra; }
:XIO ra,"WSW" is op8=0x48 & ra & rx=0 ; xcmd=0x200E   { SW = ra; swtocs(); }
:XIO ra,"RMK" is op8=0x48 & ra & rx=0 ; xcmd=0xA000   { ra = MK; }
:XIO ra,"RPIR" is op8=0x48 & ra & rx=0 ; xcmd=0xA004  { ra = PI; }
:XIO ra,"RSW" is op8=0x48 & ra & rx=0 ; xcmd=0xA00E {
	ra = (SW & 0x0fff) | (zext(CS_C) << 15) | (zext(CS_P) << 14) | (zext(CS_Z) << 13) | (zext(CS_N) << 12);
}
:XIO ra,"RCFR" is op8=0x48 & ra & rx=0 ; xcmd=0xA00F  { ra = FT; FT = 0; }
:XIO ra,"OD" is op8=0x48 & ra & rx=0 ; xcmd=0x2008  { xio_out(0x2008:2, ra); }
:XIO ra,"RNS" is op8=0x48 & ra & rx=0 ; xcmd=0x200A  { xio_out(0x200A:2, ra); }
:XIO ra,"CO" is op8=0x48 & ra & rx=0 ; xcmd=0x4000  { xio_out(0x4000:2, ra); }
:XIO ra,"CLC" is op8=0x48 & ra & rx=0 ; xcmd=0x4001  { xio_out(0x4001:2, ra); }
:XIO ra,"MPEN" is op8=0x48 & ra & rx=0 ; xcmd=0x4003  { xio_out(0x4003:2, ra); }
:XIO ra,"ESUR" is op8=0x48 & ra & rx=0 ; xcmd=0x4004  { xio_out(0x4004:2, ra); }
:XIO ra,"DMAE" is op8=0x48 & ra & rx=0 ; xcmd=0x4006  { xio_out(0x4006:2, ra); }
:XIO ra,"DMAD" is op8=0x48 & ra & rx=0 ; xcmd=0x4007  { xio_out(0x4007:2, ra); }
:XIO ra,"TAS" is op8=0x48 & ra & rx=0 ; xcmd=0x4008  { xio_out(0x4008:2, ra); }
:XIO ra,"TAH" is op8=0x48 & ra & rx=0 ; xcmd=0x4009  { xio_out(0x4009:2, ra); }
:XIO ra,"OTA" is op8=0x48 & ra & rx=0 ; xcmd=0x400A  { xio_out(0x400A:2, ra); }
:XIO ra,"GO" is op8=0x48 & ra & rx=0 ; xcmd=0x400B  { xio_out(0x400B:2, ra); }
:XIO ra,"TBS" is op8=0x48 & ra & rx=0 ; xcmd=0x400C  { xio_out(0x400C:2, ra); }
:XIO ra,"TBH" is op8=0x48 & ra & rx=0 ; xcmd=0x400D  { xio_out(0x400D:2, ra); }
:XIO ra,"OTB" is op8=0x48 & ra & rx=0 ; xcmd=0x400E  { xio_out(0x400E:2, ra); }
:XIO ra,"RIC1" is op8=0x48 & ra & rx=0 ; xcmd=0xA001  { ra = xio_in(0xA001:2); }
:XIO ra,"RIC2" is op8=0x48 & ra & rx=0 ; xcmd=0xA002  { ra = xio_in(0xA002:2); }
:XIO ra,"RDOR" is op8=0x48 & ra & rx=0 ; xcmd=0xA008  { ra = xio_in(0xA008:2); }
:XIO ra,"RDI" is op8=0x48 & ra & rx=0 ; xcmd=0xA009  { ra = xio_in(0xA009:2); }
:XIO ra,"TPIO" is op8=0x48 & ra & rx=0 ; xcmd=0xA00B  { ra = xio_in(0xA00B:2); }
:XIO ra,"RMFS" is op8=0x48 & ra & rx=0 ; xcmd=0xA00D  { ra = xio_in(0xA00D:2); }
:XIO ra,"CI" is op8=0x48 & ra & rx=0 ; xcmd=0xC000  { ra = xio_in(0xC000:2); }
:XIO ra,"RCS" is op8=0x48 & ra & rx=0 ; xcmd=0xC001  { ra = xio_in(0xC001:2); }
:XIO ra,"ITA" is op8=0x48 & ra & rx=0 ; xcmd=0xC00A  { ra = xio_in(0xC00A:2); }
:XIO ra,"ITB" is op8=0x48 & ra & rx=0 ; xcmd=0xC00E  { ra = xio_in(0xC00E:2); }
:XIO ra,imm16 is op8=0x48 & ra & rx=0 ; imm16 & cmdin=1  { ra = xio_in(imm16:2); }
:XIO ra,imm16 is op8=0x48 & ra & rx=0 ; imm16 & cmdin=0  { xio_out(imm16:2, ra); }
:XIO ra,imm16,rx is op8=0x48 & ra & rx ; imm16           { local c:2 = imm16 + rx; ra = xio(c, ra); }
:VIO ra,DA is (op8=0x49 & ra) ... & DA                   { vio(ra, DA); }

# No operation, break point, built-in function
:NOP is op8=0xFF & ra=0 & rb=0     { }
:BPT is op8=0xFF & ra=15 & rb=15   { breakpoint(); }
:BIF ex8 is op8=0x4F & ex8         { bif(ex8:1); }

# Page register commands (optional expanded memory, 4.5.2): X = group, Y = page register
:XIO ra,"WIPR",xpx,xpy is op8=0x48 & ra & rx=0 ; xhi=0x51 & xpx & xpy { local c:2 = 0x5100 | (xpx << 4) | xpy; xio_out(c, ra); }
:XIO ra,"WOPR",xpx,xpy is op8=0x48 & ra & rx=0 ; xhi=0x52 & xpx & xpy { local c:2 = 0x5200 | (xpx << 4) | xpy; xio_out(c, ra); }
:XIO ra,"RIPR",xpx,xpy is op8=0x48 & ra & rx=0 ; xhi=0xD1 & xpx & xpy { local c:2 = 0xD100 | (xpx << 4) | xpy; ra = xio_in(c); }
:XIO ra,"ROPR",xpx,xpy is op8=0x48 & ra & rx=0 ; xhi=0xD2 & xpx & xpy { local c:2 = 0xD200 | (xpx << 4) | xpy; ra = xio_in(c); }


# Load and store multiple registers R0 through RN, push and pop multiple registers (R15 is the stack pointer)
macro push(r) {
	R15 = R15 - 1;
	*[ram]:2 R15 = r;
}
macro pop(r) {
	r = *[ram]:2 R15;
	R15 = R15 + 1;
}

:LM n4,DA is (op8=0x89 & n4 & ccv=0) ... & DA { local a:2 = DA; R0 = *[ram]:2 (a + 0); }
:LM n4,DA is (op8=0x89 & n4 & ccv=1) ... & DA { local a:2 = DA; R0 = *[ram]:2 (a + 0); R1 = *[ram]:2 (a + 1); }
:LM n4,DA is (op8=0x89 & n4 & ccv=2) ... & DA { local a:2 = DA; R0 = *[ram]:2 (a + 0); R1 = *[ram]:2 (a + 1); R2 = *[ram]:2 (a + 2); }
:LM n4,DA is (op8=0x89 & n4 & ccv=3) ... & DA { local a:2 = DA; R0 = *[ram]:2 (a + 0); R1 = *[ram]:2 (a + 1); R2 = *[ram]:2 (a + 2); R3 = *[ram]:2 (a + 3); }
:LM n4,DA is (op8=0x89 & n4 & ccv=4) ... & DA { local a:2 = DA; R0 = *[ram]:2 (a + 0); R1 = *[ram]:2 (a + 1); R2 = *[ram]:2 (a + 2); R3 = *[ram]:2 (a + 3); R4 = *[ram]:2 (a + 4); }
:LM n4,DA is (op8=0x89 & n4 & ccv=5) ... & DA { local a:2 = DA; R0 = *[ram]:2 (a + 0); R1 = *[ram]:2 (a + 1); R2 = *[ram]:2 (a + 2); R3 = *[ram]:2 (a + 3); R4 = *[ram]:2 (a + 4); R5 = *[ram]:2 (a + 5); }
:LM n4,DA is (op8=0x89 & n4 & ccv=6) ... & DA { local a:2 = DA; R0 = *[ram]:2 (a + 0); R1 = *[ram]:2 (a + 1); R2 = *[ram]:2 (a + 2); R3 = *[ram]:2 (a + 3); R4 = *[ram]:2 (a + 4); R5 = *[ram]:2 (a + 5); R6 = *[ram]:2 (a + 6); }
:LM n4,DA is (op8=0x89 & n4 & ccv=7) ... & DA { local a:2 = DA; R0 = *[ram]:2 (a + 0); R1 = *[ram]:2 (a + 1); R2 = *[ram]:2 (a + 2); R3 = *[ram]:2 (a + 3); R4 = *[ram]:2 (a + 4); R5 = *[ram]:2 (a + 5); R6 = *[ram]:2 (a + 6); R7 = *[ram]:2 (a + 7); }
:LM n4,DA is (op8=0x89 & n4 & ccv=8) ... & DA { local a:2 = DA; R0 = *[ram]:2 (a + 0); R1 = *[ram]:2 (a + 1); R2 = *[ram]:2 (a + 2); R3 = *[ram]:2 (a + 3); R4 = *[ram]:2 (a + 4); R5 = *[ram]:2 (a + 5); R6 = *[ram]:2 (a + 6); R7 = *[ram]:2 (a + 7); R8 = *[ram]:2 (a + 8); }
:LM n4,DA is (op8=0x89 & n4 & ccv=9) ... & DA { local a:2 = DA; R0 = *[ram]:2 (a + 0); R1 = *[ram]:2 (a + 1); R2 = *[ram]:2 (a + 2); R3 = *[ram]:2 (a + 3); R4 = *[ram]:2 (a + 4); R5 = *[ram]:2 (a + 5); R6 = *[ram]:2 (a + 6); R7 = *[ram]:2 (a + 7); R8 = *[ram]:2 (a + 8); R9 = *[ram]:2 (a + 9); }
:LM n4,DA is (op8=0x89 & n4 & ccv=10) ... & DA { local a:2 = DA; R0 = *[ram]:2 (a + 0); R1 = *[ram]:2 (a + 1); R2 = *[ram]:2 (a + 2); R3 = *[ram]:2 (a + 3); R4 = *[ram]:2 (a + 4); R5 = *[ram]:2 (a + 5); R6 = *[ram]:2 (a + 6); R7 = *[ram]:2 (a + 7); R8 = *[ram]:2 (a + 8); R9 = *[ram]:2 (a + 9); R10 = *[ram]:2 (a + 10); }
:LM n4,DA is (op8=0x89 & n4 & ccv=11) ... & DA { local a:2 = DA; R0 = *[ram]:2 (a + 0); R1 = *[ram]:2 (a + 1); R2 = *[ram]:2 (a + 2); R3 = *[ram]:2 (a + 3); R4 = *[ram]:2 (a + 4); R5 = *[ram]:2 (a + 5); R6 = *[ram]:2 (a + 6); R7 = *[ram]:2 (a + 7); R8 = *[ram]:2 (a + 8); R9 = *[ram]:2 (a + 9); R10 = *[ram]:2 (a + 10); R11 = *[ram]:2 (a + 11); }
:LM n4,DA is (op8=0x89 & n4 & ccv=12) ... & DA { local a:2 = DA; R0 = *[ram]:2 (a + 0); R1 = *[ram]:2 (a + 1); R2 = *[ram]:2 (a + 2); R3 = *[ram]:2 (a + 3); R4 = *[ram]:2 (a + 4); R5 = *[ram]:2 (a + 5); R6 = *[ram]:2 (a + 6); R7 = *[ram]:2 (a + 7); R8 = *[ram]:2 (a + 8); R9 = *[ram]:2 (a + 9); R10 = *[ram]:2 (a + 10); R11 = *[ram]:2 (a + 11); R12 = *[ram]:2 (a + 12); }
:LM n4,DA is (op8=0x89 & n4 & ccv=13) ... & DA { local a:2 = DA; R0 = *[ram]:2 (a + 0); R1 = *[ram]:2 (a + 1); R2 = *[ram]:2 (a + 2); R3 = *[ram]:2 (a + 3); R4 = *[ram]:2 (a + 4); R5 = *[ram]:2 (a + 5); R6 = *[ram]:2 (a + 6); R7 = *[ram]:2 (a + 7); R8 = *[ram]:2 (a + 8); R9 = *[ram]:2 (a + 9); R10 = *[ram]:2 (a + 10); R11 = *[ram]:2 (a + 11); R12 = *[ram]:2 (a + 12); R13 = *[ram]:2 (a + 13); }
:LM n4,DA is (op8=0x89 & n4 & ccv=14) ... & DA { local a:2 = DA; R0 = *[ram]:2 (a + 0); R1 = *[ram]:2 (a + 1); R2 = *[ram]:2 (a + 2); R3 = *[ram]:2 (a + 3); R4 = *[ram]:2 (a + 4); R5 = *[ram]:2 (a + 5); R6 = *[ram]:2 (a + 6); R7 = *[ram]:2 (a + 7); R8 = *[ram]:2 (a + 8); R9 = *[ram]:2 (a + 9); R10 = *[ram]:2 (a + 10); R11 = *[ram]:2 (a + 11); R12 = *[ram]:2 (a + 12); R13 = *[ram]:2 (a + 13); R14 = *[ram]:2 (a + 14); }
:LM n4,DA is (op8=0x89 & n4 & ccv=15) ... & DA { local a:2 = DA; R0 = *[ram]:2 (a + 0); R1 = *[ram]:2 (a + 1); R2 = *[ram]:2 (a + 2); R3 = *[ram]:2 (a + 3); R4 = *[ram]:2 (a + 4); R5 = *[ram]:2 (a + 5); R6 = *[ram]:2 (a + 6); R7 = *[ram]:2 (a + 7); R8 = *[ram]:2 (a + 8); R9 = *[ram]:2 (a + 9); R10 = *[ram]:2 (a + 10); R11 = *[ram]:2 (a + 11); R12 = *[ram]:2 (a + 12); R13 = *[ram]:2 (a + 13); R14 = *[ram]:2 (a + 14); R15 = *[ram]:2 (a + 15); }

:STM n4,DA is (op8=0x99 & n4 & ccv=0) ... & DA { local a:2 = DA; *[ram]:2 (a + 0) = R0; }
:STM n4,DA is (op8=0x99 & n4 & ccv=1) ... & DA { local a:2 = DA; *[ram]:2 (a + 0) = R0; *[ram]:2 (a + 1) = R1; }
:STM n4,DA is (op8=0x99 & n4 & ccv=2) ... & DA { local a:2 = DA; *[ram]:2 (a + 0) = R0; *[ram]:2 (a + 1) = R1; *[ram]:2 (a + 2) = R2; }
:STM n4,DA is (op8=0x99 & n4 & ccv=3) ... & DA { local a:2 = DA; *[ram]:2 (a + 0) = R0; *[ram]:2 (a + 1) = R1; *[ram]:2 (a + 2) = R2; *[ram]:2 (a + 3) = R3; }
:STM n4,DA is (op8=0x99 & n4 & ccv=4) ... & DA { local a:2 = DA; *[ram]:2 (a + 0) = R0; *[ram]:2 (a + 1) = R1; *[ram]:2 (a + 2) = R2; *[ram]:2 (a + 3) = R3; *[ram]:2 (a + 4) = R4; }
:STM n4,DA is (op8=0x99 & n4 & ccv=5) ... & DA { local a:2 = DA; *[ram]:2 (a + 0) = R0; *[ram]:2 (a + 1) = R1; *[ram]:2 (a + 2) = R2; *[ram]:2 (a + 3) = R3; *[ram]:2 (a + 4) = R4; *[ram]:2 (a + 5) = R5; }
:STM n4,DA is (op8=0x99 & n4 & ccv=6) ... & DA { local a:2 = DA; *[ram]:2 (a + 0) = R0; *[ram]:2 (a + 1) = R1; *[ram]:2 (a + 2) = R2; *[ram]:2 (a + 3) = R3; *[ram]:2 (a + 4) = R4; *[ram]:2 (a + 5) = R5; *[ram]:2 (a + 6) = R6; }
:STM n4,DA is (op8=0x99 & n4 & ccv=7) ... & DA { local a:2 = DA; *[ram]:2 (a + 0) = R0; *[ram]:2 (a + 1) = R1; *[ram]:2 (a + 2) = R2; *[ram]:2 (a + 3) = R3; *[ram]:2 (a + 4) = R4; *[ram]:2 (a + 5) = R5; *[ram]:2 (a + 6) = R6; *[ram]:2 (a + 7) = R7; }
:STM n4,DA is (op8=0x99 & n4 & ccv=8) ... & DA { local a:2 = DA; *[ram]:2 (a + 0) = R0; *[ram]:2 (a + 1) = R1; *[ram]:2 (a + 2) = R2; *[ram]:2 (a + 3) = R3; *[ram]:2 (a + 4) = R4; *[ram]:2 (a + 5) = R5; *[ram]:2 (a + 6) = R6; *[ram]:2 (a + 7) = R7; *[ram]:2 (a + 8) = R8; }
:STM n4,DA is (op8=0x99 & n4 & ccv=9) ... & DA { local a:2 = DA; *[ram]:2 (a + 0) = R0; *[ram]:2 (a + 1) = R1; *[ram]:2 (a + 2) = R2; *[ram]:2 (a + 3) = R3; *[ram]:2 (a + 4) = R4; *[ram]:2 (a + 5) = R5; *[ram]:2 (a + 6) = R6; *[ram]:2 (a + 7) = R7; *[ram]:2 (a + 8) = R8; *[ram]:2 (a + 9) = R9; }
:STM n4,DA is (op8=0x99 & n4 & ccv=10) ... & DA { local a:2 = DA; *[ram]:2 (a + 0) = R0; *[ram]:2 (a + 1) = R1; *[ram]:2 (a + 2) = R2; *[ram]:2 (a + 3) = R3; *[ram]:2 (a + 4) = R4; *[ram]:2 (a + 5) = R5; *[ram]:2 (a + 6) = R6; *[ram]:2 (a + 7) = R7; *[ram]:2 (a + 8) = R8; *[ram]:2 (a + 9) = R9; *[ram]:2 (a + 10) = R10; }
