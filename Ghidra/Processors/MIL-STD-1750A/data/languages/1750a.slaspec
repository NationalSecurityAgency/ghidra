# MIL-STD-1750A, sixteen-bit computer instruction set architecture
# Source: MIL-STD-1750A (USAF), 2 July 1980, with Notice 1, 21 May 1982.
# Memory is word addressed: one address unit is one 16-bit word.
# Bit 0 is the most significant bit, as in the standard.
# Floating point uses the 1750A formats (24-bit mantissa, 8-bit exponent; extended adds 16 mantissa bits)
# and is modeled with pcodeops.

define endian=big;
define alignment=2;

define space ram type=ram_space size=2 wordsize=2 default;
define space register type=register_space size=2;

define register offset=0x00 size=2 [ R0 R1 R2 R3 R4 R5 R6 R7 R8 R9 R10 R11 R12 R13 R14 R15 ];
define register offset=0x40 size=2 [ IC SW MK PI FT ];
# Condition status (CS), SW bits 0-3
define register offset=0x80 size=1 [ CS_C CS_P CS_Z CS_N ];

define token instr(16)
	op8   = (8,15)
	op6   = (10,15)
	br    = (8,9)
	ra    = (4,7)
	ra1   = (4,7)
	ra2   = (4,7)
	n4    = (4,7)
	opx   = (4,7)
	cc    = (4,7)
	ccv   = (4,7)
	cc_c  = (7,7)
	cc_p  = (6,6)
	cc_z  = (5,5)
	cc_n  = (4,4)
	rb    = (0,3)
	rb1   = (0,3)
	rb2   = (0,3)
	rx    = (0,3)
	nlo   = (0,3)
	dsp   = (0,7)
	sdsp  = (0,7) signed
	ex8   = (0,7)
;

define token ext(16)
	addr16 = (0,15)
	addrv  = (0,15)
	xcmd   = (0,15)
	imm16  = (0,15)
	cmdin  = (15,15)
	xhi    = (8,15)
	xpx    = (4,7)
	xpy    = (0,3)
;

attach variables [ ra rb ] [ R0 R1 R2 R3 R4 R5 R6 R7 R8 R9 R10 R11 R12 R13 R14 R15 ];
attach variables [ ra1 rb1 ] [ R1 R2 R3 R4 R5 R6 R7 R8 R9 R10 R11 R12 R13 R14 R15 R0 ];
attach variables [ ra2 rb2 ] [ R2 R3 R4 R5 R6 R7 R8 R9 R10 R11 R12 R13 R14 R15 R0 R1 ];
attach variables [ rx ] [ _ R1 R2 R3 R4 R5 R6 R7 R8 R9 R10 R11 R12 R13 R14 R15 ];
attach variables [ br ] [ R12 R13 R14 R15 ];

define pcodeop fadd;
define pcodeop fsub;
define pcodeop fmul;
define pcodeop fdiv;
define pcodeop fcmp;
define pcodeop fabs;
define pcodeop fneg;
define pcodeop fix;
define pcodeop flt;
define pcodeop efadd;
define pcodeop efsub;
define pcodeop efmul;
define pcodeop efdiv;
define pcodeop efcmp;
define pcodeop efix;
define pcodeop eflt;
define pcodeop xio_in;
define pcodeop xio_out;
define pcodeop xio;
define pcodeop enable_interrupts;
define pcodeop disable_interrupts;
define pcodeop vio;
define pcodeop bex;
define pcodeop breakpoint;
define pcodeop bif;

macro nzp(v) {
	CS_Z = v == 0;
	CS_N = v s< 0;
	CS_P = v s> 0;
}

# Fixed point overflow sets pending interrupt 4 (PI bit 4, 0x0800)
macro ovf(c) {
	PI = PI | (zext(c) << 11);
}

macro cs(v) {
	CS_C = 0;
	nzp(v);
}

macro cmpcs(a, b) {
	CS_C = 0;
	CS_Z = a == b;
	CS_N = a s< b;
	CS_P = a s> b;
}

macro fcs(r) {
	CS_C = 0;
	CS_Z = r == 0;
	CS_N = r s< 0;
	CS_P = r s> 0;
}

macro swtocs() {
	CS_C = (SW & 0x8000) != 0;
	CS_P = (SW & 0x4000) != 0;
	CS_Z = (SW & 0x2000) != 0;
	CS_N = (SW & 0x1000) != 0;
}

# Memory direct (D) and memory direct-indexed (DX): derived address
DA: addr16      is rx=0 ; addr16  { export *[const]:2 addr16; }
DA: addr16,rx   is rx ; addr16    { local a:2 = addr16 + rx; export a; }

# Memory indirect (I) and memory indirect with pre-indexing (IX): derived address
IA: "@"^addr16    is rx=0 ; addr16  { local t:2 = addr16; local a:2 = *[ram]:2 t; export a; }
IA: "@"^addr16,rx is rx ; addr16    { local t:2 = addr16 + rx; local a:2 = *[ram]:2 t; export a; }

# Immediate long, indexable (IM/IMX)
IMX: imm16    is rx=0 ; imm16  { export *[const]:2 imm16; }
IMX: imm16,rx is rx ; imm16    { local v:2 = imm16 + rx; export v; }

# Jump targets
JD: addr16    is rx=0 ; addr16  { export *[ram]:2 addr16; }
JX: addr16,rx is rx ; addr16    { local a:2 = addr16 + rx; export a; }

# Base relative (B) and base relative-indexed (BX)
BA: br,dsp   is br & dsp  { local a:2 = br + dsp; export a; }
BXA: br      is br & rx=0 { export br; }
BXA: br,rx   is br & rx   { local a:2 = br + rx; export a; }

# N = field + 1: in bits 8-11 for shifts and INCM/DECM, in bits 12-15 for immediate short (ISP, ISN)
NP: val is n4 [ val = n4 + 1; ]      { export *[const]:2 val; }
ISP: val is nlo [ val = nlo + 1; ]   { export *[const]:2 val; }
ISN: val is nlo [ val = -(nlo + 1); ] { export *[const]:2 val; }

# Bit number N (bit 0 is the MSB)
BIT: n4 is n4 { local m:2 = 0x8000 >> n4; export m; }

# Address of the next instruction, in words (the p-code inst_next is a byte offset)
NEXT: nxt is epsilon [ nxt = inst_next; ] { export *[const]:2 nxt; }

# Instruction counter relative (ICR)
REL: dest is sdsp [ dest = inst_start + sdsp; ] { export *[ram]:2 dest; }

# Jump condition: C ANDed bit by bit with CS, then ORed; C = 7 or F is unconditional
COND: is ccv=7  { export 1:1; }
COND: is ccv=15 { export 1:1; }
COND: is cc_c & cc_p & cc_z & cc_n {
	local r:1 = (cc_c & CS_C) | (cc_p & CS_P) | (cc_z & CS_Z) | (cc_n & CS_N);
	export r;
}

:LR ra,rb is op8=0x81 & ra & ra1 & rb {
	ra = rb;
	cs(ra);
}

:L ra,DA is (op8=0x80 & ra & ra1) ... & DA {
	ra = *[ram]:2 DA;
	cs(ra);
}

:LI ra,IA is (op8=0x84 & ra & ra1) ... & IA {
	ra = *[ram]:2 IA;
	cs(ra);
}

:LISP ra,ISP is op8=0x82 & ra & ra1 & ISP {
	ra = ISP;
	cs(ra);
}

:LB BA is op6=0x00 & BA {
	R2 = *[ram]:2 BA;
	cs(R2);
}

:LBX BXA is op6=0x10 & opx=0x0 & BXA {
	R2 = *[ram]:2 BXA;
	cs(R2);
}

:AR ra,rb is op8=0xA1 & ra & ra1 & rb {
	local o:2 = rb;
	ovf(scarry(ra, o));
	CS_C = carry(ra, o);
	ra = ra + o;
	nzp(ra);
}

:A ra,DA is (op8=0xA0 & ra & ra1) ... & DA {
	local o:2 = *[ram]:2 DA;
	ovf(scarry(ra, o));
	CS_C = carry(ra, o);
	ra = ra + o;
	nzp(ra);
}

:AIM ra,imm16 is op8=0x4A & ra & ra1 & nlo=0x1 ; imm16 {
	local im:2 = imm16;
	local o:2 = im;
	ovf(scarry(ra, o));
	CS_C = carry(ra, o);
	ra = ra + o;
	nzp(ra);
}

:AISP ra,ISP is op8=0xA2 & ra & ra1 & ISP {
	local o:2 = ISP;
	ovf(scarry(ra, o));
	CS_C = carry(ra, o);
	ra = ra + o;
	nzp(ra);
}

:AB BA is op6=0x04 & BA {
	local o:2 = *[ram]:2 BA;
	ovf(scarry(R2, o));
	CS_C = carry(R2, o);
	R2 = R2 + o;
	nzp(R2);
}

:ABX BXA is op6=0x10 & opx=0x4 & BXA {
	local o:2 = *[ram]:2 BXA;
	ovf(scarry(R2, o));
	CS_C = carry(R2, o);
	R2 = R2 + o;
	nzp(R2);
}

:SR ra,rb is op8=0xB1 & ra & ra1 & rb {
	local o:2 = rb;
	ovf(sborrow(ra, o));
	CS_C = ra >= o;
	ra = ra - o;
	nzp(ra);
}

:S ra,DA is (op8=0xB0 & ra & ra1) ... & DA {
	local o:2 = *[ram]:2 DA;
	ovf(sborrow(ra, o));
	CS_C = ra >= o;
	ra = ra - o;
	nzp(ra);
}

:SIM ra,imm16 is op8=0x4A & ra & ra1 & nlo=0x2 ; imm16 {
	local im:2 = imm16;
	local o:2 = im;
	ovf(sborrow(ra, o));
	CS_C = ra >= o;
	ra = ra - o;
	nzp(ra);
}

:SISP ra,ISP is op8=0xB2 & ra & ra1 & ISP {
	local o:2 = ISP;
	ovf(sborrow(ra, o));
	CS_C = ra >= o;
	ra = ra - o;
	nzp(ra);
}

:SBB BA is op6=0x05 & BA {
	local o:2 = *[ram]:2 BA;
	ovf(sborrow(R2, o));
	CS_C = R2 >= o;
	R2 = R2 - o;
	nzp(R2);
}

:SBBX BXA is op6=0x10 & opx=0x5 & BXA {
	local o:2 = *[ram]:2 BXA;
	ovf(sborrow(R2, o));
	CS_C = R2 >= o;
	R2 = R2 - o;
	nzp(R2);
}

:MSR ra,rb is op8=0xC1 & ra & ra1 & rb {
	local p:4 = sext(ra) * sext(rb);
	ovf(p != sext(p:2));
	ra = p:2;
	cs(ra);
}

:MS ra,DA is (op8=0xC0 & ra & ra1) ... & DA {
	local p:4 = sext(ra) * sext(*[ram]:2 DA);
	ovf(p != sext(p:2));
	ra = p:2;
	cs(ra);
}

:MSIM ra,imm16 is op8=0x4A & ra & ra1 & nlo=0x4 ; imm16 {
	local im:2 = imm16;
	local p:4 = sext(ra) * sext(im);
	ovf(p != sext(p:2));
	ra = p:2;
	cs(ra);
}

:MISP ra,ISP is op8=0xC2 & ra & ra1 & ISP {
	local p:4 = sext(ra) * sext(ISP);
	ovf(p != sext(p:2));
	ra = p:2;
	cs(ra);
}

:MISN ra,ISP is op8=0xC3 & ra & ra1 & ISP & ISN {
	local p:4 = sext(ra) * sext(ISN);
	ovf(p != sext(p:2));
	ra = p:2;
	cs(ra);
}

:MR ra,rb is op8=0xC5 & ra & ra1 & rb {
	local p:4 = sext(ra) * sext(rb);
	ra = p(2);
	ra1 = p:2;
	cs(p);
}

:M ra,DA is (op8=0xC4 & ra & ra1) ... & DA {
	local p:4 = sext(ra) * sext(*[ram]:2 DA);
	ra = p(2);
	ra1 = p:2;
	cs(p);
}

:MIM ra,imm16 is op8=0x4A & ra & ra1 & nlo=0x3 ; imm16 {
	local im:2 = imm16;
	local p:4 = sext(ra) * sext(im);
	ra = p(2);
	ra1 = p:2;
	cs(p);
}

:MB BA is op6=0x06 & BA {
	local p:4 = sext(R2) * sext(*[ram]:2 BA);
	R2 = p(2);
	R3 = p:2;
	cs(p);
}

:MBX BXA is op6=0x10 & opx=0x6 & BXA {
	local p:4 = sext(R2) * sext(*[ram]:2 BXA);
	R2 = p(2);
	R3 = p:2;
	cs(p);
}

:DVR ra,rb is op8=0xD1 & ra & ra1 & rb {
	local o:2 = rb;
	ovf((o == 0) || ((ra == 0x8000) && (o == 0xffff)));
	local q:2 = ra s/ o;
	local r:2 = ra s% o;
	ra = q;
	ra1 = r;
	cs(q);
}

:DV ra,DA is (op8=0xD0 & ra & ra1) ... & DA {
	local o:2 = *[ram]:2 DA;
	ovf((o == 0) || ((ra == 0x8000) && (o == 0xffff)));
	local q:2 = ra s/ o;
	local r:2 = ra s% o;
	ra = q;
	ra1 = r;
	cs(q);
}

:DVIM ra,imm16 is op8=0x4A & ra & ra1 & nlo=0x6 ; imm16 {
	local im:2 = imm16;
	local o:2 = im;
	ovf((o == 0) || ((ra == 0x8000) && (o == 0xffff)));
	local q:2 = ra s/ o;
	local r:2 = ra s% o;
	ra = q;
	ra1 = r;
	cs(q);
}

:DISP ra,ISP is op8=0xD2 & ra & ra1 & ISP {
	local o:2 = ISP;
	ovf((o == 0) || ((ra == 0x8000) && (o == 0xffff)));
	local q:2 = ra s/ o;
	local r:2 = ra s% o;
	ra = q;
	ra1 = r;
	cs(q);
}

:DISN ra,ISP is op8=0xD3 & ra & ra1 & ISP & ISN {
	local o:2 = ISN;
	ovf((o == 0) || ((ra == 0x8000) && (o == 0xffff)));
	local q:2 = ra s/ o;
	local r:2 = ra s% o;
	ra = q;
	ra1 = r;
	cs(q);
}

:DR ra,rb is op8=0xD5 & ra & ra1 & rb {
	local o:4 = sext(rb);
	local v:4 = ((zext(ra) << 16) | zext(ra1));
	ovf(o == 0);
	local q:4 = v s/ o;
	local r:4 = v s% o;
	ovf((q s> 0x7fff) || (q s< -0x8000));
	ra = q:2;
	ra1 = r:2;
	cs(ra);
}

:D ra,DA is (op8=0xD4 & ra & ra1) ... & DA {
	local o:4 = sext(*[ram]:2 DA);
	local v:4 = ((zext(ra) << 16) | zext(ra1));
	ovf(o == 0);
	local q:4 = v s/ o;
	local r:4 = v s% o;
	ovf((q s> 0x7fff) || (q s< -0x8000));
	ra = q:2;
	ra1 = r:2;
	cs(ra);
}

:DIM ra,imm16 is op8=0x4A & ra & ra1 & nlo=0x5 ; imm16 {
	local im:2 = imm16;
	local o:4 = sext(im);
	local v:4 = ((zext(ra) << 16) | zext(ra1));
	ovf(o == 0);
	local q:4 = v s/ o;
	local r:4 = v s% o;
	ovf((q s> 0x7fff) || (q s< -0x8000));
	ra = q:2;
	ra1 = r:2;
	cs(ra);
}

:DB BA is op6=0x07 & BA {
	local o:4 = sext(*[ram]:2 BA);
	local v:4 = ((zext(R2) << 16) | zext(R3));
	ovf(o == 0);
	local q:4 = v s/ o;
	local r:4 = v s% o;
	ovf((q s> 0x7fff) || (q s< -0x8000));
	R2 = q:2;
	R3 = r:2;
	cs(R2);
}

:DBX BXA is op6=0x10 & opx=0x7 & BXA {
	local o:4 = sext(*[ram]:2 BXA);
	local v:4 = ((zext(R2) << 16) | zext(R3));
	ovf(o == 0);
	local q:4 = v s/ o;
	local r:4 = v s% o;
	ovf((q s> 0x7fff) || (q s< -0x8000));
	R2 = q:2;
	R3 = r:2;
	cs(R2);
}

:ORR ra,rb is op8=0xE1 & ra & ra1 & rb {
	ra = ra | rb;
	cs(ra);
}

:OR ra,DA is (op8=0xE0 & ra & ra1) ... & DA {
	ra = ra | *[ram]:2 DA;
	cs(ra);
}

:ORIM ra,imm16 is op8=0x4A & ra & ra1 & nlo=0x8 ; imm16 {
	local im:2 = imm16;
	ra = ra | im;
	cs(ra);
}

:ORB BA is op6=0x0C & BA {
	R2 = R2 | *[ram]:2 BA;
	cs(R2);
}

:ORBX BXA is op6=0x10 & opx=0xF & BXA {
	R2 = R2 | *[ram]:2 BXA;
	cs(R2);
}

:ANDR ra,rb is op8=0xE3 & ra & ra1 & rb {
	ra = ra & rb;
	cs(ra);
}

:AND ra,DA is (op8=0xE2 & ra & ra1) ... & DA {
	ra = ra & *[ram]:2 DA;
	cs(ra);
}

:ANDM ra,imm16 is op8=0x4A & ra & ra1 & nlo=0x7 ; imm16 {
	local im:2 = imm16;
	ra = ra & im;
	cs(ra);
}

:ANDB BA is op6=0x0D & BA {
	R2 = R2 & *[ram]:2 BA;
	cs(R2);
}

:ANDX BXA is op6=0x10 & opx=0xE & BXA {
	R2 = R2 & *[ram]:2 BXA;
	cs(R2);
}

:XORR ra,rb is op8=0xE5 & ra & ra1 & rb {
	ra = ra ^ rb;
	cs(ra);
}

:XOR ra,DA is (op8=0xE4 & ra & ra1) ... & DA {
	ra = ra ^ *[ram]:2 DA;
	cs(ra);
}

:XORM ra,imm16 is op8=0x4A & ra & ra1 & nlo=0x9 ; imm16 {
	local im:2 = imm16;
	ra = ra ^ im;
	cs(ra);
}

:NR ra,rb is op8=0xE7 & ra & ra1 & rb {
	ra = ~(ra & rb);
	cs(ra);
}

:N ra,DA is (op8=0xE6 & ra & ra1) ... & DA {
	ra = ~(ra & *[ram]:2 DA);
	cs(ra);
}

:NIM ra,imm16 is op8=0x4A & ra & ra1 & nlo=0xB ; imm16 {
	local im:2 = imm16;
	ra = ~(ra & im);
	cs(ra);
}

:CR ra,rb is op8=0xF1 & ra & ra1 & rb {
	cmpcs(ra, rb);
}

:C ra,DA is (op8=0xF0 & ra & ra1) ... & DA {
	cmpcs(ra, *[ram]:2 DA);
}

:CIM ra,imm16 is op8=0x4A & ra & ra1 & nlo=0xA ; imm16 {
	local im:2 = imm16;
	cmpcs(ra, im);
}

:CISP ra,ISP is op8=0xF2 & ra & ra1 & ISP {
	cmpcs(ra, ISP);
}

:CISN ra,ISP is op8=0xF3 & ra & ra1 & ISP & ISN {
	cmpcs(ra, ISN);
}

:CB BA is op6=0x0E & BA {
	cmpcs(R2, *[ram]:2 BA);
}

:CBX BXA is op6=0x10 & opx=0xC & BXA {
	cmpcs(R2, *[ram]:2 BXA);
}

:LISN ra,ISP is op8=0x83 & ra & ISP & ISN {
	ra = ISN;
	cs(ra);
}
:LIM ra,IMX is (op8=0x85 & ra) ... & IMX {
	ra = IMX;
	cs(ra);
}

:DLR ra,rb is op8=0x87 & ra & ra1 & rb & rb1 {
	local o:4 = ((zext(rb) << 16) | zext(rb1));
	ra = o(2);
	ra1 = o:2;
	cs(o);
}

:DL ra,DA is (op8=0x86 & ra & ra1) ... & DA {
	local o:4 = *[ram]:4 DA;
	ra = o(2);
	ra1 = o:2;
	cs(o);
}

:DLI ra,IA is (op8=0x88 & ra & ra1) ... & IA {
	local o:4 = *[ram]:4 IA;
	ra = o(2);
	ra1 = o:2;
	cs(o);
}

:DLB BA is op6=0x01 & BA {
	local o:4 = *[ram]:4 BA;
	R0 = o(2);
	R1 = o:2;
	cs(o);
}

:DLBX BXA is op6=0x10 & opx=0x1 & BXA {
	local o:4 = *[ram]:4 BXA;
	R0 = o(2);
	R1 = o:2;
	cs(o);
}

:DAR ra,rb is op8=0xA7 & ra & ra1 & rb & rb1 {
	local o:4 = ((zext(rb) << 16) | zext(rb1));
	local v:4 = ((zext(ra) << 16) | zext(ra1));
	ovf(scarry(v, o));
	CS_C = carry(v, o);
	local r:4 = v + o;
	ra = r(2);
	ra1 = r:2;
	nzp(r);
}

:DA ra,DA is (op8=0xA6 & ra & ra1) ... & DA {
	local o:4 = *[ram]:4 DA;
	local v:4 = ((zext(ra) << 16) | zext(ra1));
	ovf(scarry(v, o));
	CS_C = carry(v, o);
	local r:4 = v + o;
	ra = r(2);
	ra1 = r:2;
	nzp(r);
}

:DSR ra,rb is op8=0xB7 & ra & ra1 & rb & rb1 {
	local o:4 = ((zext(rb) << 16) | zext(rb1));
	local v:4 = ((zext(ra) << 16) | zext(ra1));
	ovf(sborrow(v, o));
	CS_C = v >= o;
	local r:4 = v - o;
	ra = r(2);
	ra1 = r:2;
	nzp(r);
}

:DS ra,DA is (op8=0xB6 & ra & ra1) ... & DA {
	local o:4 = *[ram]:4 DA;
	local v:4 = ((zext(ra) << 16) | zext(ra1));
	ovf(sborrow(v, o));
	CS_C = v >= o;
	local r:4 = v - o;
	ra = r(2);
	ra1 = r:2;
	nzp(r);
}

:DMR ra,rb is op8=0xC7 & ra & ra1 & rb & rb1 {
	local o:4 = ((zext(rb) << 16) | zext(rb1));
	local v:4 = ((zext(ra) << 16) | zext(ra1));
	local p:8 = sext(v) * sext(o);
	ovf(p != sext(p:4));
	local r:4 = p:4;
	ra = r(2);
	ra1 = r:2;
	cs(r);
}

:DM ra,DA is (op8=0xC6 & ra & ra1) ... & DA {
	local o:4 = *[ram]:4 DA;
	local v:4 = ((zext(ra) << 16) | zext(ra1));
	local p:8 = sext(v) * sext(o);
	ovf(p != sext(p:4));
	local r:4 = p:4;
	ra = r(2);
	ra1 = r:2;
	cs(r);
}

:DDR ra,rb is op8=0xD7 & ra & ra1 & rb & rb1 {
	local o:4 = ((zext(rb) << 16) | zext(rb1));
	local v:4 = ((zext(ra) << 16) | zext(ra1));
	ovf((o == 0) || ((v == 0x80000000) && (o == 0xffffffff)));
	local r:4 = v s/ o;
	ra = r(2);
	ra1 = r:2;
	cs(r);
}

:DD ra,DA is (op8=0xD6 & ra & ra1) ... & DA {
	local o:4 = *[ram]:4 DA;
	local v:4 = ((zext(ra) << 16) | zext(ra1));
	ovf((o == 0) || ((v == 0x80000000) && (o == 0xffffffff)));
	local r:4 = v s/ o;
	ra = r(2);
	ra1 = r:2;
	cs(r);
}

:DCR ra,rb is op8=0xF7 & ra & ra1 & rb & rb1 {
	local o:4 = ((zext(rb) << 16) | zext(rb1));
	local v:4 = ((zext(ra) << 16) | zext(ra1));
	cmpcs(v, o);
}

:DC ra,DA is (op8=0xF6 & ra & ra1) ... & DA {
	local o:4 = *[ram]:4 DA;
