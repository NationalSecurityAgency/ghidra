:EFAR ra,rb is op8=0xAB & ra & ra1 & ra2 & rb & rb1 & rb2 {
	local o:6 = ((zext(rb) << 32) | (zext(rb1) << 16) | zext(rb2));
	local v:6 = ((zext(ra) << 32) | (zext(ra1) << 16) | zext(ra2));
	local r:6 = efadd(v, o);
	ra = r(4);
	ra1 = r(2);
	ra2 = r:2;
	fcs(r);
}

:EFA ra,DA is (op8=0xAA & ra & ra1 & ra2) ... & DA {
	local o:6 = *[ram]:6 DA;
	local v:6 = ((zext(ra) << 32) | (zext(ra1) << 16) | zext(ra2));
	local r:6 = efadd(v, o);
	ra = r(4);
	ra1 = r(2);
	ra2 = r:2;
	fcs(r);
}

:EFSR ra,rb is op8=0xBB & ra & ra1 & ra2 & rb & rb1 & rb2 {
	local o:6 = ((zext(rb) << 32) | (zext(rb1) << 16) | zext(rb2));
	local v:6 = ((zext(ra) << 32) | (zext(ra1) << 16) | zext(ra2));
	local r:6 = efsub(v, o);
	ra = r(4);
	ra1 = r(2);
	ra2 = r:2;
