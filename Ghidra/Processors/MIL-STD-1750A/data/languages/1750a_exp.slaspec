	ovf(sborrow(v, NP));
	CS_C = v >= NP;
	v = v - NP;
	local pi141:2 = ((SW & 0xf) << 5) | 0x10 | ((a) >> 12); local pp141:3 = zext(*[pagefile]:2 pi141) & 0xff; local pa141:3 = (pp141 << 12) | zext((a) & 0xfff); *[ram]:2 pa141 = v;
	nzp(v);
}

# Absolute value and negate
:ABS ra,rb is op8=0xA4 & ra & rb {
	local o:2 = rb;
	ovf(o == 0x8000);
	local s:2 = zext(o s< 0);
	ra = (o ^ -s) + s;
	cs(ra);
}
:NEG ra,rb is op8=0xB4 & ra & rb   { ovf(rb == 0x8000); ra = -rb; cs(ra); }
:DABS ra,rb is op8=0xA5 & ra & ra1 & rb & rb1 {
	local o:4 = (zext(rb) << 16) | zext(rb1);
	ovf(o == 0x80000000);
	local s:4 = zext(o s< 0);
	local r:4 = (o ^ -s) + s;
	ra = r(2);
	ra1 = r:2;
	cs(r);
}
:DNEG ra,rb is op8=0xB5 & ra & ra1 & rb & rb1 {
	local o:4 = (zext(rb) << 16) | zext(rb1);
	ovf(o == 0x80000000);
	local r:4 = -o;
	ra = r(2);
	ra1 = r:2;
	cs(r);
}
:FABS ra,rb is op8=0xAC & ra & ra1 & rb & rb1 {
	local o:4 = (zext(rb) << 16) | zext(rb1);
	local r:4 = fabs(o);
	ra = r(2);
	ra1 = r:2;
	fcs(r);
}
:FNEG ra,rb is op8=0xBC & ra & ra1 & rb & rb1 {
	local o:4 = (zext(rb) << 16) | zext(rb1);
	local r:4 = fneg(o);
	ra = r(2);
	ra1 = r:2;
	fcs(r);
}

# Conversions
:FIX ra,rb is op8=0xE8 & ra & rb & rb1 {
	local e:1 = rb1:1;
	ovf(e s> 0x0f);
	if (e s> 0x0f) goto inst_next;
	local o:4 = (zext(rb) << 16) | zext(rb1);
	ra = fix(o);
	cs(ra);
}
:FLT ra,rb is op8=0xE9 & ra & ra1 & rb         { local r:4 = flt(rb); ra = r(2); ra1 = r:2; fcs(r); }
:EFIX ra,rb is op8=0xEA & ra & ra1 & rb & rb1 & rb2 {
	local e:1 = rb1:1;
	ovf(e s> 0x1f);
	if (e s> 0x1f) goto inst_next;
	local o:6 = (zext(rb) << 32) | (zext(rb1) << 16) | zext(rb2);
	local r:4 = efix(o);
	ra = r(2);
	ra1 = r:2;
	cs(r);
}
:EFLT ra,rb is op8=0xEB & ra & ra1 & ra2 & rb & rb1 {
	local o:4 = (zext(rb) << 16) | zext(rb1);
	local r:6 = eflt(o);
	ra = r(4);
	ra1 = r(2);
	ra2 = r:2;
	fcs(r);
}

# Exchange bytes, exchange words
:XBR ra is op8=0xEC & ra & rb=0     { ra = (ra << 8) | (ra >> 8); cs(ra); }
:XWR ra,rb is op8=0xED & ra & rb    { local t:2 = ra; ra = rb; rb = t; cs(ra); }

# Compare between limits: DO1 = [DA], DO2 = [DA+1]
:CBL ra,DA is (op8=0xF4 & ra) ... & DA {
	local a:2 = DA;
	local pi142:2 = ((SW & 0xf) << 5) | 0x10 | ((a) >> 12); local pp142:3 = zext(*[pagefile]:2 pi142) & 0xff; local pa142:3 = (pp142 << 12) | zext((a) & 0xfff); local lo:2 = *[ram]:2 pa142;
	local pi143:2 = ((SW & 0xf) << 5) | 0x10 | (((a + 1)) >> 12); local pp143:3 = zext(*[pagefile]:2 pi143) & 0xff; local pa143:3 = (pp143 << 12) | zext(((a + 1)) & 0xfff); local hi:2 = *[ram]:2 pa143;
	CS_C = lo s> hi;
	CS_N = !CS_C && (ra s< lo);
	CS_P = !CS_C && (ra s> hi);
	CS_Z = !CS_C && !CS_N && !CS_P;
}

# Shifts, count N in the instruction (field holds N-1)
:SLL rb,NP is op8=0x60 & rb & NP    { rb = rb << NP; cs(rb); }
:SRL rb,NP is op8=0x61 & rb & NP    { rb = rb >> NP; cs(rb); }
:SRA rb,NP is op8=0x62 & rb & NP    { rb = rb s>> NP; cs(rb); }
:SLC rb,NP is op8=0x63 & rb & NP    { rb = (rb << NP) | (rb >> (16 - NP)); cs(rb); }
:DSLL rb,NP is op8=0x65 & rb & rb1 & NP {
	local v:4 = ((zext(rb) << 16) | zext(rb1)) << NP;
	rb = v(2); rb1 = v:2; cs(v);
}
:DSRL rb,NP is op8=0x66 & rb & rb1 & NP {
	local v:4 = ((zext(rb) << 16) | zext(rb1)) >> NP;
	rb = v(2); rb1 = v:2; cs(v);
}
:DSRA rb,NP is op8=0x67 & rb & rb1 & NP {
	local v:4 = ((zext(rb) << 16) | zext(rb1)) s>> NP;
	rb = v(2); rb1 = v:2; cs(v);
}
:DSLC rb,NP is op8=0x68 & rb & rb1 & NP {
	local o:4 = (zext(rb) << 16) | zext(rb1);
	local v:4 = (o << NP) | (o >> (32 - NP));
	rb = v(2); rb1 = v:2; cs(v);
}

# Shifts, count in register RB: positive shifts left, negative shifts right.
# A count outside -16..16 (-32..32 for double shifts) is a fixed point overflow and no shift.
:SLR ra,rb is op8=0x6A & ra & rb {
	local n:2 = rb;
	ovf((n s> 16) || (n s< -16));
	if ((n s> 16) || (n s< -16)) goto inst_next;
	ra = (ra << n) * zext(n s>= 0) + (ra >> -n) * zext(n s< 0);
	cs(ra);
}
:SAR ra,rb is op8=0x6B & ra & rb {
	local n:2 = rb;
	ovf((n s> 16) || (n s< -16));
	if ((n s> 16) || (n s< -16)) goto inst_next;
	ovf((n s> 0) && (((ra << n) s>> n) != ra));
	ra = (ra << n) * zext(n s>= 0) + (ra s>> -n) * zext(n s< 0);
	cs(ra);
}
:SCR ra,rb is op8=0x6C & ra & rb {
	ovf((rb s> 16) || (rb s< -16));
	if ((rb s> 16) || (rb s< -16)) goto inst_next;
	local n:2 = rb & 0xf;
	ra = (ra << n) | (ra >> (16 - n));
	cs(ra);
}
:DSLR ra,rb is op8=0x6D & ra & ra1 & rb {
	local n:4 = sext(rb);
	ovf((n s> 32) || (n s< -32));
	if ((n s> 32) || (n s< -32)) goto inst_next;
	local o:4 = (zext(ra) << 16) | zext(ra1);
	local v:4 = (o << n) * zext(n s>= 0) + (o >> -n) * zext(n s< 0);
	ra = v(2); ra1 = v:2; cs(v);
}
:DSAR ra,rb is op8=0x6E & ra & ra1 & rb {
	local n:4 = sext(rb);
	ovf((n s> 32) || (n s< -32));
	if ((n s> 32) || (n s< -32)) goto inst_next;
	local o:4 = (zext(ra) << 16) | zext(ra1);
	ovf((n s> 0) && (((o << n) s>> n) != o));
	local v:4 = (o << n) * zext(n s>= 0) + (o s>> -n) * zext(n s< 0);
	ra = v(2); ra1 = v:2; cs(v);
}
:DSCR ra,rb is op8=0x6F & ra & ra1 & rb {
	ovf((rb s> 32) || (rb s< -32));
	if ((rb s> 32) || (rb s< -32)) goto inst_next;
	local n:4 = sext(rb) & 0x1f;
	local o:4 = (zext(ra) << 16) | zext(ra1);
	local v:4 = (o << n) | (o >> (32 - n));
	ra = v(2); ra1 = v:2; cs(v);
}

# Bit operations; bit N counts from the MSB
:SBR n4,rb is op8=0x51 & n4 & rb & BIT      { rb = rb | BIT; }
:SB n4,DA is (op8=0x50 & n4 & BIT) ... & DA   { local a:2 = DA; local pi144:2 = ((SW & 0xf) << 5) | 0x10 | ((a) >> 12); local pp144:3 = zext(*[pagefile]:2 pi144) & 0xff; local pa144:3 = (pp144 << 12) | zext((a) & 0xfff); local pi145:2 = ((SW & 0xf) << 5) | 0x10 | ((a) >> 12); local pp145:3 = zext(*[pagefile]:2 pi145) & 0xff; local pa145:3 = (pp145 << 12) | zext((a) & 0xfff); *[ram]:2 pa144 = *[ram]:2 pa145 | BIT; }
:SBI n4,IA is (op8=0x52 & n4 & BIT) ... & IA  { local a:2 = IA; local pi146:2 = ((SW & 0xf) << 5) | 0x10 | ((a) >> 12); local pp146:3 = zext(*[pagefile]:2 pi146) & 0xff; local pa146:3 = (pp146 << 12) | zext((a) & 0xfff); local pi147:2 = ((SW & 0xf) << 5) | 0x10 | ((a) >> 12); local pp147:3 = zext(*[pagefile]:2 pi147) & 0xff; local pa147:3 = (pp147 << 12) | zext((a) & 0xfff); *[ram]:2 pa146 = *[ram]:2 pa147 | BIT; }
:RBR n4,rb is op8=0x54 & n4 & rb & BIT      { rb = rb & ~BIT; }
:RB n4,DA is (op8=0x53 & n4 & BIT) ... & DA   { local a:2 = DA; local pi148:2 = ((SW & 0xf) << 5) | 0x10 | ((a) >> 12); local pp148:3 = zext(*[pagefile]:2 pi148) & 0xff; local pa148:3 = (pp148 << 12) | zext((a) & 0xfff); local pi149:2 = ((SW & 0xf) << 5) | 0x10 | ((a) >> 12); local pp149:3 = zext(*[pagefile]:2 pi149) & 0xff; local pa149:3 = (pp149 << 12) | zext((a) & 0xfff); *[ram]:2 pa148 = *[ram]:2 pa149 & ~BIT; }
:RBI n4,IA is (op8=0x55 & n4 & BIT) ... & IA  { local a:2 = IA; local pi150:2 = ((SW & 0xf) << 5) | 0x10 | ((a) >> 12); local pp150:3 = zext(*[pagefile]:2 pi150) & 0xff; local pa150:3 = (pp150 << 12) | zext((a) & 0xfff); local pi151:2 = ((SW & 0xf) << 5) | 0x10 | ((a) >> 12); local pp151:3 = zext(*[pagefile]:2 pi151) & 0xff; local pa151:3 = (pp151 << 12) | zext((a) & 0xfff); *[ram]:2 pa150 = *[ram]:2 pa151 & ~BIT; }

macro testbit(v, m) {
	local b:1 = (v & m) != 0;
	CS_C = 0;
	CS_Z = !b;
	CS_N = b && (m == 0x8000);
	CS_P = b && (m != 0x8000);
}

:TBR n4,rb is op8=0x57 & n4 & rb & BIT      { testbit(rb, BIT); }
:TB n4,DA is (op8=0x56 & n4 & BIT) ... & DA   { local pi152:2 = ((SW & 0xf) << 5) | 0x10 | ((DA) >> 12); local pp152:3 = zext(*[pagefile]:2 pi152) & 0xff; local pa152:3 = (pp152 << 12) | zext((DA) & 0xfff); testbit(*[ram]:2 pa152, BIT); }
:TBI n4,IA is (op8=0x58 & n4 & BIT) ... & IA  { local pi153:2 = ((SW & 0xf) << 5) | 0x10 | ((IA) >> 12); local pp153:3 = zext(*[pagefile]:2 pi153) & 0xff; local pa153:3 = (pp153 << 12) | zext((IA) & 0xfff); testbit(*[ram]:2 pa153, BIT); }
:TSB n4,DA is (op8=0x59 & n4 & BIT) ... & DA  {
	local a:2 = DA;
	local pi154:2 = ((SW & 0xf) << 5) | 0x10 | ((a) >> 12); local pp154:3 = zext(*[pagefile]:2 pi154) & 0xff; local pa154:3 = (pp154 << 12) | zext((a) & 0xfff); local v:2 = *[ram]:2 pa154;
	testbit(v, BIT);
	local pi155:2 = ((SW & 0xf) << 5) | 0x10 | ((a) >> 12); local pp155:3 = zext(*[pagefile]:2 pi155) & 0xff; local pa155:3 = (pp155 << 12) | zext((a) & 0xfff); *[ram]:2 pa155 = v | BIT;
}
:SVBR ra,rb is op8=0x5A & ra & rb    { rb = rb | (0x8000 >> (ra & 0xf)); }
:RVBR ra,rb is op8=0x5C & ra & rb    { rb = rb & ~(0x8000 >> (ra & 0xf)); }
:TVBR ra,rb is op8=0x5E & ra & rb    { local m:2 = 0x8000 >> (ra & 0xf); testbit(rb, m); }

# Branches, instruction counter relative
:BR REL  is op8=0x74 & REL  { goto REL; }
:BEZ REL is op8=0x75 & REL  { if (CS_Z) goto REL; }
:BLT REL is op8=0x76 & REL  { if (CS_N) goto REL; }
:BLE REL is op8=0x78 & REL  { if (CS_N || CS_Z) goto REL; }
:BGT REL is op8=0x79 & REL  { if (CS_P) goto REL; }
:BNZ REL is op8=0x7A & REL  { if (!CS_Z) goto REL; }
:BGE REL is op8=0x7B & REL  { if (CS_P || CS_Z) goto REL; }

# Jump on condition
:JC cc,JD is (op8=0x70 & cc & COND) ... & JD   { if (COND) goto JD; }
:JC cc,JX is (op8=0x70 & cc & COND) ... & JX   { local t:2 = JX; if (!COND) goto inst_next; local pi439:2 = ((SW & 0xf) << 5) | 0 | ((t) >> 12); local pp439:3 = zext(*[pagefile]:2 pi439) & 0xff; local pa439:3 = (pp439 << 12) | zext((t) & 0xfff); goto [pa439]; }
# Unconditional indexed jump from location zero: the return from JS (5.25)
:JC cc,addr16,rx is (op8=0x70 & cc & ccv=7 & rx) ; addr16 & addrv=0  { local pi440:2 = ((SW & 0xf) << 5) | 0 | ((rx) >> 12); local pp440:3 = zext(*[pagefile]:2 pi440) & 0xff; local pa440:3 = (pp440 << 12) | zext((rx) & 0xfff); return [pa440]; }
:JC cc,addr16,rx is (op8=0x70 & cc & ccv=15 & rx) ; addr16 & addrv=0 { local pi441:2 = ((SW & 0xf) << 5) | 0 | ((rx) >> 12); local pp441:3 = zext(*[pagefile]:2 pi441) & 0xff; local pa441:3 = (pp441 << 12) | zext((rx) & 0xfff); return [pa441]; }
:JCI cc,IA is (op8=0x71 & cc & COND) ... & IA  { local t:2 = IA; if (!COND) goto inst_next; local pi442:2 = ((SW & 0xf) << 5) | 0 | ((t) >> 12); local pp442:3 = zext(*[pagefile]:2 pi442) & 0xff; local pa442:3 = (pp442 << 12) | zext((t) & 0xfff); goto [pa442]; }

# Jump to subroutine, return address in RA
:JS ra,JD is (op8=0x72 & ra & NEXT) ... & JD   { ra = NEXT; call JD; }
:JS ra,JX is (op8=0x72 & ra & NEXT) ... & JX   { local t:2 = JX; ra = NEXT; local pi443:2 = ((SW & 0xf) << 5) | 0 | ((t) >> 12); local pp443:3 = zext(*[pagefile]:2 pi443) & 0xff; local pa443:3 = (pp443 << 12) | zext((t) & 0xfff); call [pa443]; }

# Subtract one and jump
:SOJ ra,JD is (op8=0x73 & ra) ... & JD  { ra = ra - 1; cs(ra); if (ra != 0) goto JD; }
:SOJ ra,JX is (op8=0x73 & ra) ... & JX  { local t:2 = JX; ra = ra - 1; cs(ra); if (ra == 0) goto inst_next; local pi444:2 = ((SW & 0xf) << 5) | 0 | ((t) >> 12); local pp444:3 = zext(*[pagefile]:2 pi444) & 0xff; local pa444:3 = (pp444 << 12) | zext((t) & 0xfff); goto [pa444]; }

# Stack IC and jump to subroutine, unstack IC and return
:SJS ra,JD is (op8=0x7E & ra & NEXT) ... & JD  { ra = ra - 1; local pi156:2 = ((SW & 0xf) << 5) | 0x10 | ((ra) >> 12); local pp156:3 = zext(*[pagefile]:2 pi156) & 0xff; local pa156:3 = (pp156 << 12) | zext((ra) & 0xfff); *[ram]:2 pa156 = NEXT; call JD; }
:SJS ra,JX is (op8=0x7E & ra & NEXT) ... & JX  { local t:2 = JX; ra = ra - 1; local pi157:2 = ((SW & 0xf) << 5) | 0x10 | ((ra) >> 12); local pp157:3 = zext(*[pagefile]:2 pi157) & 0xff; local pa157:3 = (pp157 << 12) | zext((ra) & 0xfff); *[ram]:2 pa157 = NEXT; local pi445:2 = ((SW & 0xf) << 5) | 0 | ((t) >> 12); local pp445:3 = zext(*[pagefile]:2 pi445) & 0xff; local pa445:3 = (pp445 << 12) | zext((t) & 0xfff); call [pa445]; }
:URS ra is op8=0x7F & ra & rb=0         { local pi158:2 = ((SW & 0xf) << 5) | 0x10 | ((ra) >> 12); local pp158:3 = zext(*[pagefile]:2 pi158) & 0xff; local pa158:3 = (pp158 << 12) | zext((ra) & 0xfff); local t:2 = *[ram]:2 pa158; ra = ra + 1; local pi446:2 = ((SW & 0xf) << 5) | 0 | ((t) >> 12); local pp446:3 = zext(*[pagefile]:2 pi446) & 0xff; local pa446:3 = (pp446 << 12) | zext((t) & 0xfff); return [pa446]; }

# Load status: (MK, SW, IC) <-- [DA, DA+1, DA+2]
:LST DA is (op8=0x7D & n4=0) ... & DA {
	local a:2 = DA;
	local pi159:2 = ((SW & 0xf) << 5) | 0x10 | ((a) >> 12); local pp159:3 = zext(*[pagefile]:2 pi159) & 0xff; local pa159:3 = (pp159 << 12) | zext((a) & 0xfff); local m:2 = *[ram]:2 pa159;
	local pi160:2 = ((SW & 0xf) << 5) | 0x10 | (((a + 1)) >> 12); local pp160:3 = zext(*[pagefile]:2 pi160) & 0xff; local pa160:3 = (pp160 << 12) | zext(((a + 1)) & 0xfff); local s:2 = *[ram]:2 pa160;
	local pi161:2 = ((SW & 0xf) << 5) | 0x10 | (((a + 2)) >> 12); local pp161:3 = zext(*[pagefile]:2 pi161) & 0xff; local pa161:3 = (pp161 << 12) | zext(((a + 2)) & 0xfff); local t:2 = *[ram]:2 pa161;
	MK = m;
	SW = s;
	swtocs();
	local pi447:2 = ((SW & 0xf) << 5) | 0 | ((t) >> 12); local pp447:3 = zext(*[pagefile]:2 pi447) & 0xff; local pa447:3 = (pp447 << 12) | zext((t) & 0xfff); return [pa447];
}
:LSTI IA is (op8=0x7C & n4=0) ... & IA {
	local a:2 = IA;
	local pi162:2 = ((SW & 0xf) << 5) | 0x10 | ((a) >> 12); local pp162:3 = zext(*[pagefile]:2 pi162) & 0xff; local pa162:3 = (pp162 << 12) | zext((a) & 0xfff); local m:2 = *[ram]:2 pa162;
	local pi163:2 = ((SW & 0xf) << 5) | 0x10 | (((a + 1)) >> 12); local pp163:3 = zext(*[pagefile]:2 pi163) & 0xff; local pa163:3 = (pp163 << 12) | zext(((a + 1)) & 0xfff); local s:2 = *[ram]:2 pa163;
	local pi164:2 = ((SW & 0xf) << 5) | 0x10 | (((a + 2)) >> 12); local pp164:3 = zext(*[pagefile]:2 pi164) & 0xff; local pa164:3 = (pp164 << 12) | zext(((a + 2)) & 0xfff); local t:2 = *[ram]:2 pa164;
	MK = m;
	SW = s;
	swtocs();
	local pi448:2 = ((SW & 0xf) << 5) | 0 | ((t) >> 12); local pp448:3 = zext(*[pagefile]:2 pi448) & 0xff; local pa448:3 = (pp448 << 12) | zext((t) & 0xfff); return [pa448];
}

# Branch to executive
:BEX nlo is op8=0x77 & n4=0 & nlo  { bex(nlo:1); }

# Input/output (5.1). Mandatory commands that act on the processor registers are modeled;
# other commands are named and use the xio_out/xio_in pcodeops. Commands w/ bit 0 (the MSB) set are input.
:XIO ra,"SMK" is op8=0x48 & ra & rx=0 ; xcmd=0x2000   { MK = ra; }
:XIO ra,"CLIR" is op8=0x48 & ra & rx=0 ; xcmd=0x2001  { PI = 0; FT = 0; }
:XIO ra,"ENBL" is op8=0x48 & ra & rx=0 ; xcmd=0x2002  { enable_interrupts(); }
:XIO ra,"DSBL" is op8=0x48 & ra & rx=0 ; xcmd=0x2003  { disable_interrupts(); }
:XIO ra,"RPI" is op8=0x48 & ra & rx=0 ; xcmd=0x2004 {
	local n:2 = ra & 0xf;
	PI = PI & ~(0x8000 >> n);
	FT = FT * zext(n != 1);
}
:XIO ra,"SPI" is op8=0x48 & ra & rx=0 ; xcmd=0x2005   { PI = PI | ra; }
:XIO ra,"WSW" is op8=0x48 & ra & rx=0 ; xcmd=0x200E   { SW = ra; swtocs(); }
:XIO ra,"RMK" is op8=0x48 & ra & rx=0 ; xcmd=0xA000   { ra = MK; }
:XIO ra,"RPIR" is op8=0x48 & ra & rx=0 ; xcmd=0xA004  { ra = PI; }
:XIO ra,"RSW" is op8=0x48 & ra & rx=0 ; xcmd=0xA00E {
	ra = (SW & 0x0fff) | (zext(CS_C) << 15) | (zext(CS_P) << 14) | (zext(CS_Z) << 13) | (zext(CS_N) << 12);
}
:XIO ra,"RCFR" is op8=0x48 & ra & rx=0 ; xcmd=0xA00F  { ra = FT; FT = 0; }
:XIO ra,"OD" is op8=0x48 & ra & rx=0 ; xcmd=0x2008  { xio_out(0x2008:2, ra); }
:XIO ra,"RNS" is op8=0x48 & ra & rx=0 ; xcmd=0x200A  { xio_out(0x200A:2, ra); }
:XIO ra,"CO" is op8=0x48 & ra & rx=0 ; xcmd=0x4000  { xio_out(0x4000:2, ra); }
:XIO ra,"CLC" is op8=0x48 & ra & rx=0 ; xcmd=0x4001  { xio_out(0x4001:2, ra); }
:XIO ra,"MPEN" is op8=0x48 & ra & rx=0 ; xcmd=0x4003  { xio_out(0x4003:2, ra); }
:XIO ra,"ESUR" is op8=0x48 & ra & rx=0 ; xcmd=0x4004  { xio_out(0x4004:2, ra); }
:XIO ra,"DMAE" is op8=0x48 & ra & rx=0 ; xcmd=0x4006  { xio_out(0x4006:2, ra); }
:XIO ra,"DMAD" is op8=0x48 & ra & rx=0 ; xcmd=0x4007  { xio_out(0x4007:2, ra); }
:XIO ra,"TAS" is op8=0x48 & ra & rx=0 ; xcmd=0x4008  { xio_out(0x4008:2, ra); }
:XIO ra,"TAH" is op8=0x48 & ra & rx=0 ; xcmd=0x4009  { xio_out(0x4009:2, ra); }
:XIO ra,"OTA" is op8=0x48 & ra & rx=0 ; xcmd=0x400A  { xio_out(0x400A:2, ra); }
:XIO ra,"GO" is op8=0x48 & ra & rx=0 ; xcmd=0x400B  { xio_out(0x400B:2, ra); }
:XIO ra,"TBS" is op8=0x48 & ra & rx=0 ; xcmd=0x400C  { xio_out(0x400C:2, ra); }
:XIO ra,"TBH" is op8=0x48 & ra & rx=0 ; xcmd=0x400D  { xio_out(0x400D:2, ra); }
:XIO ra,"OTB" is op8=0x48 & ra & rx=0 ; xcmd=0x400E  { xio_out(0x400E:2, ra); }
:XIO ra,"RIC1" is op8=0x48 & ra & rx=0 ; xcmd=0xA001  { ra = xio_in(0xA001:2); }
:XIO ra,"RIC2" is op8=0x48 & ra & rx=0 ; xcmd=0xA002  { ra = xio_in(0xA002:2); }
:XIO ra,"RDOR" is op8=0x48 & ra & rx=0 ; xcmd=0xA008  { ra = xio_in(0xA008:2); }
:XIO ra,"RDI" is op8=0x48 & ra & rx=0 ; xcmd=0xA009  { ra = xio_in(0xA009:2); }
:XIO ra,"TPIO" is op8=0x48 & ra & rx=0 ; xcmd=0xA00B  { ra = xio_in(0xA00B:2); }
:XIO ra,"RMFS" is op8=0x48 & ra & rx=0 ; xcmd=0xA00D  { ra = xio_in(0xA00D:2); }
:XIO ra,"CI" is op8=0x48 & ra & rx=0 ; xcmd=0xC000  { ra = xio_in(0xC000:2); }
:XIO ra,"RCS" is op8=0x48 & ra & rx=0 ; xcmd=0xC001  { ra = xio_in(0xC001:2); }
:XIO ra,"ITA" is op8=0x48 & ra & rx=0 ; xcmd=0xC00A  { ra = xio_in(0xC00A:2); }
:XIO ra,"ITB" is op8=0x48 & ra & rx=0 ; xcmd=0xC00E  { ra = xio_in(0xC00E:2); }
:XIO ra,imm16 is op8=0x48 & ra & rx=0 ; imm16 & cmdin=1  { ra = xio_in(imm16:2); }
:XIO ra,imm16 is op8=0x48 & ra & rx=0 ; imm16 & cmdin=0  { xio_out(imm16:2, ra); }
:XIO ra,imm16,rx is op8=0x48 & ra & rx ; imm16           { local c:2 = imm16 + rx; ra = xio(c, ra); }
:VIO ra,DA is (op8=0x49 & ra) ... & DA                   { vio(ra, DA); }

# No operation, break point, built-in function
:NOP is op8=0xFF & ra=0 & rb=0     { }
:BPT is op8=0xFF & ra=15 & rb=15   { breakpoint(); }
:BIF ex8 is op8=0x4F & ex8         { bif(ex8:1); }

# Page register commands (optional expanded memory, 4.5.2): X = group, Y = page register
:XIO ra,"WIPR",xpx,xpy is op8=0x48 & ra & rx=0 ; xhi=0x51 & xpx & xpy { local ix:2 = (xpx << 5) | 0 | xpy; *[pagefile]:2 ix = ra; }
:XIO ra,"WOPR",xpx,xpy is op8=0x48 & ra & rx=0 ; xhi=0x52 & xpx & xpy { local ix:2 = (xpx << 5) | 16 | xpy; *[pagefile]:2 ix = ra; }
:XIO ra,"RIPR",xpx,xpy is op8=0x48 & ra & rx=0 ; xhi=0xD1 & xpx & xpy { local ix:2 = (xpx << 5) | 0 | xpy; ra = *[pagefile]:2 ix; }
:XIO ra,"ROPR",xpx,xpy is op8=0x48 & ra & rx=0 ; xhi=0xD2 & xpx & xpy { local ix:2 = (xpx << 5) | 16 | xpy; ra = *[pagefile]:2 ix; }


# Load and store multiple registers R0 through RN, push and pop multiple registers (R15 is the stack pointer)
macro push(r) {
	R15 = R15 - 1;
	local pi165:2 = ((SW & 0xf) << 5) | 0x10 | ((R15) >> 12); local pp165:3 = zext(*[pagefile]:2 pi165) & 0xff; local pa165:3 = (pp165 << 12) | zext((R15) & 0xfff); *[ram]:2 pa165 = r;
}
macro pop(r) {
	local pi166:2 = ((SW & 0xf) << 5) | 0x10 | ((R15) >> 12); local pp166:3 = zext(*[pagefile]:2 pi166) & 0xff; local pa166:3 = (pp166 << 12) | zext((R15) & 0xfff); r = *[ram]:2 pa166;
	R15 = R15 + 1;
}

