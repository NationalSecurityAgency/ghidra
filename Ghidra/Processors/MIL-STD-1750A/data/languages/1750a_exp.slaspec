# MIL-STD-1750A, sixteen-bit computer instruction set architecture, w/ expanded memory addressing (4.5.2)
# Source: MIL-STD-1750A (USAF), 2 July 1980, with Notice 1, 21 May 1982.
# Memory is word addressed: one address unit is one 16-bit word.
# Bit 0 is the most significant bit, as in the standard.
# Floating point uses the 1750A formats (24-bit mantissa, 8-bit exponent; extended adds 16 mantissa bits)
# and is modeled with pcodeops.

define endian=big;
define alignment=2;

define space ram type=ram_space size=3 wordsize=2 default;
# Page file: index = group * 32 + set * 16 + register (set 0 = instruction, 1 = operand)
define space pagefile type=ram_space size=2 wordsize=2;
define space register type=register_space size=2;

define register offset=0x00 size=2 [ R0 R1 R2 R3 R4 R5 R6 R7 R8 R9 R10 R11 R12 R13 R14 R15 ];
define register offset=0x40 size=2 [ IC SW MK PI FT ];
# Condition status (CS), SW bits 0-3
define register offset=0x80 size=1 [ CS_C CS_P CS_Z CS_N ];

define token instr(16)
	op8   = (8,15)
	op6   = (10,15)
	br    = (8,9)
	ra    = (4,7)
	ra1   = (4,7)
	ra2   = (4,7)
	n4    = (4,7)
	opx   = (4,7)
	cc    = (4,7)
	ccv   = (4,7)
	cc_c  = (7,7)
	cc_p  = (6,6)
	cc_z  = (5,5)
	cc_n  = (4,4)
	rb    = (0,3)
	rb1   = (0,3)
	rb2   = (0,3)
	rx    = (0,3)
	nlo   = (0,3)
	dsp   = (0,7)
	sdsp  = (0,7) signed
	ex8   = (0,7)
;

define token ext(16)
	addr16 = (0,15)
	addrv  = (0,15)
	xcmd   = (0,15)
	imm16  = (0,15)
	cmdin  = (15,15)
	xhi    = (8,15)
	xpx    = (4,7)
	xpy    = (0,3)
;

attach variables [ ra rb ] [ R0 R1 R2 R3 R4 R5 R6 R7 R8 R9 R10 R11 R12 R13 R14 R15 ];
attach variables [ ra1 rb1 ] [ R1 R2 R3 R4 R5 R6 R7 R8 R9 R10 R11 R12 R13 R14 R15 R0 ];
attach variables [ ra2 rb2 ] [ R2 R3 R4 R5 R6 R7 R8 R9 R10 R11 R12 R13 R14 R15 R0 R1 ];
attach variables [ rx ] [ _ R1 R2 R3 R4 R5 R6 R7 R8 R9 R10 R11 R12 R13 R14 R15 ];
attach variables [ br ] [ R12 R13 R14 R15 ];

define pcodeop fadd;
define pcodeop fsub;
define pcodeop fmul;
define pcodeop fdiv;
define pcodeop fcmp;
define pcodeop fabs;
define pcodeop fneg;
define pcodeop fix;
define pcodeop flt;
define pcodeop efadd;
define pcodeop efsub;
define pcodeop efmul;
define pcodeop efdiv;
define pcodeop efcmp;
define pcodeop efix;
define pcodeop eflt;
define pcodeop xio_in;
define pcodeop xio_out;
define pcodeop xio;
define pcodeop enable_interrupts;
define pcodeop disable_interrupts;
define pcodeop vio;
define pcodeop bex;
define pcodeop breakpoint;
define pcodeop bif;

macro nzp(v) {
	CS_Z = v == 0;
	CS_N = v s< 0;
	CS_P = v s> 0;
}

# Fixed point overflow sets pending interrupt 4 (PI bit 4, 0x0800)
macro ovf(c) {
	PI = PI | (zext(c) << 11);
}

macro cs(v) {
	CS_C = 0;
	nzp(v);
}

macro cmpcs(a, b) {
	CS_C = 0;
	CS_Z = a == b;
	CS_N = a s< b;
	CS_P = a s> b;
}

macro fcs(r) {
	CS_C = 0;
	CS_Z = r == 0;
	CS_N = r s< 0;
	CS_P = r s> 0;
}

macro swtocs() {
	CS_C = (SW & 0x8000) != 0;
	CS_P = (SW & 0x4000) != 0;
	CS_Z = (SW & 0x2000) != 0;
	CS_N = (SW & 0x1000) != 0;
}

# Memory direct (D) and memory direct-indexed (DX): derived address
DA: addr16      is rx=0 ; addr16  { export *[const]:2 addr16; }
DA: addr16,rx   is rx ; addr16    { local a:2 = addr16 + rx; export a; }

# Memory indirect (I) and memory indirect with pre-indexing (IX): derived address
IA: "@"^addr16    is rx=0 ; addr16  { local t:2 = addr16; local pi6:2 = ((SW & 0xf) << 5) | 0x10 | ((t) >> 12); local pp6:3 = zext(*[pagefile]:2 pi6) & 0xff; local pa6:3 = (pp6 << 12) | zext((t) & 0xfff); local a:2 = *[ram]:2 pa6; export a; }
IA: "@"^addr16,rx is rx ; addr16    { local t:2 = addr16 + rx; local pi7:2 = ((SW & 0xf) << 5) | 0x10 | ((t) >> 12); local pp7:3 = zext(*[pagefile]:2 pi7) & 0xff; local pa7:3 = (pp7 << 12) | zext((t) & 0xfff); local a:2 = *[ram]:2 pa7; export a; }

# Immediate long, indexable (IM/IMX)
IMX: imm16    is rx=0 ; imm16  { export *[const]:2 imm16; }
IMX: imm16,rx is rx ; imm16    { local v:2 = imm16 + rx; export v; }

# Jump targets
JD: dest      is rx=0 ; addr16 [ dest = (inst_start & 0xf0000) | addr16; ] { export *[ram]:2 dest; }
JX: addr16,rx is rx ; addr16    { local a:2 = addr16 + rx; export a; }

# Base relative (B) and base relative-indexed (BX)
BA: br,dsp   is br & dsp  { local a:2 = br + dsp; export a; }
BXA: br      is br & rx=0 { export br; }
BXA: br,rx   is br & rx   { local a:2 = br + rx; export a; }

# N = field + 1: in bits 8-11 for shifts and INCM/DECM, in bits 12-15 for immediate short (ISP, ISN)
NP: val is n4 [ val = n4 + 1; ]      { export *[const]:2 val; }
ISP: val is nlo [ val = nlo + 1; ]   { export *[const]:2 val; }
ISN: val is nlo [ val = -(nlo + 1); ] { export *[const]:2 val; }

# Bit number N (bit 0 is the MSB)
BIT: n4 is n4 { local m:2 = 0x8000 >> n4; export m; }

# Address of the next instruction, in words (the p-code inst_next is a byte offset)
NEXT: nxt is epsilon [ nxt = inst_next & 0xffff; ] { export *[const]:2 nxt; }

# Instruction counter relative (ICR)
REL: dest is sdsp [ dest = (inst_start & 0xf0000) | ((inst_start + sdsp) & 0xffff); ] { export *[ram]:2 dest; }

# Jump condition: C ANDed bit by bit with CS, then ORed; C = 7 or F is unconditional
COND: is ccv=7  { export 1:1; }
COND: is ccv=15 { export 1:1; }
COND: is cc_c & cc_p & cc_z & cc_n {
	local r:1 = (cc_c & CS_C) | (cc_p & CS_P) | (cc_z & CS_Z) | (cc_n & CS_N);
	export r;
}

:LR ra,rb is op8=0x81 & ra & ra1 & rb {
	ra = rb;
	cs(ra);
}

:L ra,DA is (op8=0x80 & ra & ra1) ... & DA {
	local pi8:2 = ((SW & 0xf) << 5) | 0x10 | ((DA) >> 12); local pp8:3 = zext(*[pagefile]:2 pi8) & 0xff; local pa8:3 = (pp8 << 12) | zext((DA) & 0xfff); ra = *[ram]:2 pa8;
	cs(ra);
}

:LI ra,IA is (op8=0x84 & ra & ra1) ... & IA {
	local pi9:2 = ((SW & 0xf) << 5) | 0x10 | ((IA) >> 12); local pp9:3 = zext(*[pagefile]:2 pi9) & 0xff; local pa9:3 = (pp9 << 12) | zext((IA) & 0xfff); ra = *[ram]:2 pa9;
	cs(ra);
}

:LISP ra,ISP is op8=0x82 & ra & ra1 & ISP {
	ra = ISP;
	cs(ra);
}

:LB BA is op6=0x00 & BA {
	local pi10:2 = ((SW & 0xf) << 5) | 0x10 | ((BA) >> 12); local pp10:3 = zext(*[pagefile]:2 pi10) & 0xff; local pa10:3 = (pp10 << 12) | zext((BA) & 0xfff); R2 = *[ram]:2 pa10;
	cs(R2);
}

:LBX BXA is op6=0x10 & opx=0x0 & BXA {
	local pi11:2 = ((SW & 0xf) << 5) | 0x10 | ((BXA) >> 12); local pp11:3 = zext(*[pagefile]:2 pi11) & 0xff; local pa11:3 = (pp11 << 12) | zext((BXA) & 0xfff); R2 = *[ram]:2 pa11;
	cs(R2);
}

:AR ra,rb is op8=0xA1 & ra & ra1 & rb {
	local o:2 = rb;
	ovf(scarry(ra, o));
	CS_C = carry(ra, o);
	ra = ra + o;
	nzp(ra);
}

:A ra,DA is (op8=0xA0 & ra & ra1) ... & DA {
	local pi12:2 = ((SW & 0xf) << 5) | 0x10 | ((DA) >> 12); local pp12:3 = zext(*[pagefile]:2 pi12) & 0xff; local pa12:3 = (pp12 << 12) | zext((DA) & 0xfff); local o:2 = *[ram]:2 pa12;
	ovf(scarry(ra, o));
	CS_C = carry(ra, o);
	ra = ra + o;
	nzp(ra);
}

:AIM ra,imm16 is op8=0x4A & ra & ra1 & nlo=0x1 ; imm16 {
	local im:2 = imm16;
	local o:2 = im;
	ovf(scarry(ra, o));
	CS_C = carry(ra, o);
	ra = ra + o;
	nzp(ra);
}

:AISP ra,ISP is op8=0xA2 & ra & ra1 & ISP {
	local o:2 = ISP;
	ovf(scarry(ra, o));
	CS_C = carry(ra, o);
	ra = ra + o;
	nzp(ra);
}

:AB BA is op6=0x04 & BA {
	local pi13:2 = ((SW & 0xf) << 5) | 0x10 | ((BA) >> 12); local pp13:3 = zext(*[pagefile]:2 pi13) & 0xff; local pa13:3 = (pp13 << 12) | zext((BA) & 0xfff); local o:2 = *[ram]:2 pa13;
	ovf(scarry(R2, o));
	CS_C = carry(R2, o);
	R2 = R2 + o;
	nzp(R2);
}

:ABX BXA is op6=0x10 & opx=0x4 & BXA {
	local pi14:2 = ((SW & 0xf) << 5) | 0x10 | ((BXA) >> 12); local pp14:3 = zext(*[pagefile]:2 pi14) & 0xff; local pa14:3 = (pp14 << 12) | zext((BXA) & 0xfff); local o:2 = *[ram]:2 pa14;
	ovf(scarry(R2, o));
	CS_C = carry(R2, o);
	R2 = R2 + o;
	nzp(R2);
}

:SR ra,rb is op8=0xB1 & ra & ra1 & rb {
	local o:2 = rb;
	ovf(sborrow(ra, o));
	CS_C = ra >= o;
	ra = ra - o;
	nzp(ra);
}

:S ra,DA is (op8=0xB0 & ra & ra1) ... & DA {
	local pi15:2 = ((SW & 0xf) << 5) | 0x10 | ((DA) >> 12); local pp15:3 = zext(*[pagefile]:2 pi15) & 0xff; local pa15:3 = (pp15 << 12) | zext((DA) & 0xfff); local o:2 = *[ram]:2 pa15;
	ovf(sborrow(ra, o));
	CS_C = ra >= o;
	ra = ra - o;
	nzp(ra);
}

:SIM ra,imm16 is op8=0x4A & ra & ra1 & nlo=0x2 ; imm16 {
	local im:2 = imm16;
	local o:2 = im;
	ovf(sborrow(ra, o));
	CS_C = ra >= o;
	ra = ra - o;
	nzp(ra);
}

:SISP ra,ISP is op8=0xB2 & ra & ra1 & ISP {
	local o:2 = ISP;
	ovf(sborrow(ra, o));
	CS_C = ra >= o;
	ra = ra - o;
	nzp(ra);
}

:SBB BA is op6=0x05 & BA {
	local pi16:2 = ((SW & 0xf) << 5) | 0x10 | ((BA) >> 12); local pp16:3 = zext(*[pagefile]:2 pi16) & 0xff; local pa16:3 = (pp16 << 12) | zext((BA) & 0xfff); local o:2 = *[ram]:2 pa16;
	ovf(sborrow(R2, o));
	CS_C = R2 >= o;
	R2 = R2 - o;
	nzp(R2);
}

:SBBX BXA is op6=0x10 & opx=0x5 & BXA {
	local pi17:2 = ((SW & 0xf) << 5) | 0x10 | ((BXA) >> 12); local pp17:3 = zext(*[pagefile]:2 pi17) & 0xff; local pa17:3 = (pp17 << 12) | zext((BXA) & 0xfff); local o:2 = *[ram]:2 pa17;
	ovf(sborrow(R2, o));
	CS_C = R2 >= o;
	R2 = R2 - o;
	nzp(R2);
}

:MSR ra,rb is op8=0xC1 & ra & ra1 & rb {
	local p:4 = sext(ra) * sext(rb);
	ovf(p != sext(p:2));
	ra = p:2;
	cs(ra);
}

:MS ra,DA is (op8=0xC0 & ra & ra1) ... & DA {
	local pi18:2 = ((SW & 0xf) << 5) | 0x10 | ((DA) >> 12); local pp18:3 = zext(*[pagefile]:2 pi18) & 0xff; local pa18:3 = (pp18 << 12) | zext((DA) & 0xfff); local p:4 = sext(ra) * sext(*[ram]:2 pa18);
	ovf(p != sext(p:2));
	ra = p:2;
	cs(ra);
}

:MSIM ra,imm16 is op8=0x4A & ra & ra1 & nlo=0x4 ; imm16 {
	local im:2 = imm16;
	local p:4 = sext(ra) * sext(im);
	ovf(p != sext(p:2));
	ra = p:2;
	cs(ra);
}

:MISP ra,ISP is op8=0xC2 & ra & ra1 & ISP {
	local p:4 = sext(ra) * sext(ISP);
	ovf(p != sext(p:2));
	ra = p:2;
	cs(ra);
}

:MISN ra,ISP is op8=0xC3 & ra & ra1 & ISP & ISN {
	local p:4 = sext(ra) * sext(ISN);
	ovf(p != sext(p:2));
	ra = p:2;
	cs(ra);
}

:MR ra,rb is op8=0xC5 & ra & ra1 & rb {
	local p:4 = sext(ra) * sext(rb);
	ra = p(2);
	ra1 = p:2;
	cs(p);
}

:M ra,DA is (op8=0xC4 & ra & ra1) ... & DA {
	local pi19:2 = ((SW & 0xf) << 5) | 0x10 | ((DA) >> 12); local pp19:3 = zext(*[pagefile]:2 pi19) & 0xff; local pa19:3 = (pp19 << 12) | zext((DA) & 0xfff); local p:4 = sext(ra) * sext(*[ram]:2 pa19);
	ra = p(2);
	ra1 = p:2;
	cs(p);
}

:MIM ra,imm16 is op8=0x4A & ra & ra1 & nlo=0x3 ; imm16 {
	local im:2 = imm16;
	local p:4 = sext(ra) * sext(im);
	ra = p(2);
	ra1 = p:2;
	cs(p);
}

:MB BA is op6=0x06 & BA {
	local pi20:2 = ((SW & 0xf) << 5) | 0x10 | ((BA) >> 12); local pp20:3 = zext(*[pagefile]:2 pi20) & 0xff; local pa20:3 = (pp20 << 12) | zext((BA) & 0xfff); local p:4 = sext(R2) * sext(*[ram]:2 pa20);
	R2 = p(2);
	R3 = p:2;
	cs(p);
}

:MBX BXA is op6=0x10 & opx=0x6 & BXA {
	local pi21:2 = ((SW & 0xf) << 5) | 0x10 | ((BXA) >> 12); local pp21:3 = zext(*[pagefile]:2 pi21) & 0xff; local pa21:3 = (pp21 << 12) | zext((BXA) & 0xfff); local p:4 = sext(R2) * sext(*[ram]:2 pa21);
	R2 = p(2);
	R3 = p:2;
	cs(p);
}

:DVR ra,rb is op8=0xD1 & ra & ra1 & rb {
	local o:2 = rb;
	ovf((o == 0) || ((ra == 0x8000) && (o == 0xffff)));
	local q:2 = ra s/ o;
	local r:2 = ra s% o;
	ra = q;
	ra1 = r;
	cs(q);
}

:DV ra,DA is (op8=0xD0 & ra & ra1) ... & DA {
	local pi22:2 = ((SW & 0xf) << 5) | 0x10 | ((DA) >> 12); local pp22:3 = zext(*[pagefile]:2 pi22) & 0xff; local pa22:3 = (pp22 << 12) | zext((DA) & 0xfff); local o:2 = *[ram]:2 pa22;
	ovf((o == 0) || ((ra == 0x8000) && (o == 0xffff)));
	local q:2 = ra s/ o;
	local r:2 = ra s% o;
	ra = q;
	ra1 = r;
	cs(q);
}

:DVIM ra,imm16 is op8=0x4A & ra & ra1 & nlo=0x6 ; imm16 {
	local im:2 = imm16;
	local o:2 = im;
	ovf((o == 0) || ((ra == 0x8000) && (o == 0xffff)));
	local q:2 = ra s/ o;
	local r:2 = ra s% o;
	ra = q;
	ra1 = r;
	cs(q);
}

:DISP ra,ISP is op8=0xD2 & ra & ra1 & ISP {
	local o:2 = ISP;
	ovf((o == 0) || ((ra == 0x8000) && (o == 0xffff)));
	local q:2 = ra s/ o;
	local r:2 = ra s% o;
	ra = q;
	ra1 = r;
	cs(q);
}

:DISN ra,ISP is op8=0xD3 & ra & ra1 & ISP & ISN {
	local o:2 = ISN;
	ovf((o == 0) || ((ra == 0x8000) && (o == 0xffff)));
	local q:2 = ra s/ o;
	local r:2 = ra s% o;
	ra = q;
	ra1 = r;
	cs(q);
}

:DR ra,rb is op8=0xD5 & ra & ra1 & rb {
	local o:4 = sext(rb);
	local v:4 = ((zext(ra) << 16) | zext(ra1));
	ovf(o == 0);
	local q:4 = v s/ o;
	local r:4 = v s% o;
	ovf((q s> 0x7fff) || (q s< -0x8000));
	ra = q:2;
	ra1 = r:2;
	cs(ra);
}

:D ra,DA is (op8=0xD4 & ra & ra1) ... & DA {
	local pi23:2 = ((SW & 0xf) << 5) | 0x10 | ((DA) >> 12); local pp23:3 = zext(*[pagefile]:2 pi23) & 0xff; local pa23:3 = (pp23 << 12) | zext((DA) & 0xfff); local o:4 = sext(*[ram]:2 pa23);
	local v:4 = ((zext(ra) << 16) | zext(ra1));
	ovf(o == 0);
	local q:4 = v s/ o;
	local r:4 = v s% o;
	ovf((q s> 0x7fff) || (q s< -0x8000));
	ra = q:2;
	ra1 = r:2;
	cs(ra);
}

:DIM ra,imm16 is op8=0x4A & ra & ra1 & nlo=0x5 ; imm16 {
	local im:2 = imm16;
	local o:4 = sext(im);
	local v:4 = ((zext(ra) << 16) | zext(ra1));
	ovf(o == 0);
	local q:4 = v s/ o;
	local r:4 = v s% o;
	ovf((q s> 0x7fff) || (q s< -0x8000));
	ra = q:2;
	ra1 = r:2;
	cs(ra);
}

:DB BA is op6=0x07 & BA {
	local pi24:2 = ((SW & 0xf) << 5) | 0x10 | ((BA) >> 12); local pp24:3 = zext(*[pagefile]:2 pi24) & 0xff; local pa24:3 = (pp24 << 12) | zext((BA) & 0xfff); local o:4 = sext(*[ram]:2 pa24);
	local v:4 = ((zext(R2) << 16) | zext(R3));
	ovf(o == 0);
	local q:4 = v s/ o;
	local r:4 = v s% o;
	ovf((q s> 0x7fff) || (q s< -0x8000));
	R2 = q:2;
	R3 = r:2;
	cs(R2);
}

:DBX BXA is op6=0x10 & opx=0x7 & BXA {
	local pi25:2 = ((SW & 0xf) << 5) | 0x10 | ((BXA) >> 12); local pp25:3 = zext(*[pagefile]:2 pi25) & 0xff; local pa25:3 = (pp25 << 12) | zext((BXA) & 0xfff); local o:4 = sext(*[ram]:2 pa25);
	local v:4 = ((zext(R2) << 16) | zext(R3));
	ovf(o == 0);
	local q:4 = v s/ o;
	local r:4 = v s% o;
	ovf((q s> 0x7fff) || (q s< -0x8000));
	R2 = q:2;
	R3 = r:2;
	cs(R2);
}

:ORR ra,rb is op8=0xE1 & ra & ra1 & rb {
	ra = ra | rb;
	cs(ra);
}

:OR ra,DA is (op8=0xE0 & ra & ra1) ... & DA {
	local pi26:2 = ((SW & 0xf) << 5) | 0x10 | ((DA) >> 12); local pp26:3 = zext(*[pagefile]:2 pi26) & 0xff; local pa26:3 = (pp26 << 12) | zext((DA) & 0xfff); ra = ra | *[ram]:2 pa26;
	cs(ra);
}

:ORIM ra,imm16 is op8=0x4A & ra & ra1 & nlo=0x8 ; imm16 {
	local im:2 = imm16;
	ra = ra | im;
	cs(ra);
}

:ORB BA is op6=0x0C & BA {
	local pi27:2 = ((SW & 0xf) << 5) | 0x10 | ((BA) >> 12); local pp27:3 = zext(*[pagefile]:2 pi27) & 0xff; local pa27:3 = (pp27 << 12) | zext((BA) & 0xfff); R2 = R2 | *[ram]:2 pa27;
	cs(R2);
}

:ORBX BXA is op6=0x10 & opx=0xF & BXA {
	local pi28:2 = ((SW & 0xf) << 5) | 0x10 | ((BXA) >> 12); local pp28:3 = zext(*[pagefile]:2 pi28) & 0xff; local pa28:3 = (pp28 << 12) | zext((BXA) & 0xfff); R2 = R2 | *[ram]:2 pa28;
	cs(R2);
}

:ANDR ra,rb is op8=0xE3 & ra & ra1 & rb {
	ra = ra & rb;
	cs(ra);
}

:AND ra,DA is (op8=0xE2 & ra & ra1) ... & DA {
	local pi29:2 = ((SW & 0xf) << 5) | 0x10 | ((DA) >> 12); local pp29:3 = zext(*[pagefile]:2 pi29) & 0xff; local pa29:3 = (pp29 << 12) | zext((DA) & 0xfff); ra = ra & *[ram]:2 pa29;
	cs(ra);
}

:ANDM ra,imm16 is op8=0x4A & ra & ra1 & nlo=0x7 ; imm16 {
	local im:2 = imm16;
	ra = ra & im;
	cs(ra);
}

:ANDB BA is op6=0x0D & BA {
	local pi30:2 = ((SW & 0xf) << 5) | 0x10 | ((BA) >> 12); local pp30:3 = zext(*[pagefile]:2 pi30) & 0xff; local pa30:3 = (pp30 << 12) | zext((BA) & 0xfff); R2 = R2 & *[ram]:2 pa30;
	cs(R2);
}

:ANDX BXA is op6=0x10 & opx=0xE & BXA {
	local pi31:2 = ((SW & 0xf) << 5) | 0x10 | ((BXA) >> 12); local pp31:3 = zext(*[pagefile]:2 pi31) & 0xff; local pa31:3 = (pp31 << 12) | zext((BXA) & 0xfff); R2 = R2 & *[ram]:2 pa31;
	cs(R2);
}

:XORR ra,rb is op8=0xE5 & ra & ra1 & rb {
	ra = ra ^ rb;
	cs(ra);
