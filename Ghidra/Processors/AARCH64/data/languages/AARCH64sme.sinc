define pcodeop SME_smopa_s;
define pcodeop SME_smopa_d;

# SMOPA
# MATCH xa0800000/mask=xffe0001c
# MATCH xa0c00000/mask=xffe00018

SmePm_m: sme_pm_1315^"/m" is sme_pm_1315 { export sme_pm_1315; }

SmeZA_S: "za"^sme_za_s_0001^".s" is sme_za_s_0001 & b_02=0 & b_03=0 & b_04=0
{
	export *[const]:1 sme_za_s_0001;
}

SmeZA_D: "za"^sme_za_d_0002^".d" is sme_za_d_0002 & b_03=0 & b_04=0
{
	export *[const]:1 sme_za_d_0002;
}

SmeZm_B: sve_zm_1620^".B" is sve_zm_1620 { export sve_zm_1620; }
SmeZm_H: sve_zm_1620^".H" is sve_zm_1620 { export sve_zm_1620; }

:smopa SmeZA_S, Pg3_m, SmePm_m, Zn.B, SmeZm_B
is sve_b_2531=0b1010000 & b_24=0 & b_23=1 & b_22=0 & b_21=0
   & sve_zm_1620 & sme_pm_1315 & sve_pg_1012 & sve_zn_0509
   & SmeZA_S & Pg3_m & SmePm_m & Zn.B & SmeZm_B
{
	SME_smopa_s(SmeZA_S, Pg3_m, SmePm_m, Zn.B, SmeZm_B);
}

:smopa SmeZA_D, Pg3_m, SmePm_m, Zn.H, SmeZm_H
is sve_b_2531=0b1010000 & b_24=0 & b_23=1 & b_22=1 & b_21=0
   & sve_zm_1620 & sme_pm_1315 & sve_pg_1012 & sve_zn_0509
   & SmeZA_D & Pg3_m & SmePm_m & Zn.H & SmeZm_H
{
	SME_smopa_d(SmeZA_D, Pg3_m, SmePm_m, Zn.H, SmeZm_H);
}
