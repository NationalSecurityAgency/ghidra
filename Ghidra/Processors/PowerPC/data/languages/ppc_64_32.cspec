<?xml version="1.0" encoding="UTF-8"?>
<!-- This cspec describes the 32-bit ABI for PowerPC as it is implemented for 64-bit code.
     Presumably this ABI allows binary compatibility of 64-bit code with existing 32-bit code.
     The ABI assumes 32-bit registers and addresses, in particular the maximum sized integer value
     that can be passed in a single register is 4 bytes (even though the register is 8 bytes long).
     The cspec currently has a limited ability to model this: the maxsize attribute must still be
     set to 8 for parameter passing registers r3 - r10.
-->
<compiler_spec>
  <global>
    <range space="ram"/>
  </global>
  <data_organization>
	<pointer_size value="4"/>
  </data_organization>
  <aggressivetrim signext="true"/>  <!-- Pointers are 4-bytes but are held in 8-byte registers -->
  <stackpointer register="r1" space="ram"/>
  <default_proto>
    <prototype name="__stdcall" extrapop="0" stackshift="0">
      <input>
        <pentry minsize="1" maxsize="8" metatype="float" extension="float">
          <register name="f1"/>
        </pentry>
        <pentry minsize="1" maxsize="8" metatype="float" extension="float">
          <register name="f2"/>
        </pentry>
        <pentry minsize="1" maxsize="8" metatype="float" extension="float">
          <register name="f3"/>
        </pentry>
        <pentry minsize="1" maxsize="8" metatype="float" extension="float">
          <register name="f4"/>
        </pentry>
        <pentry minsize="1" maxsize="8" metatype="float" extension="float">
          <register name="f5"/>
        </pentry>
        <pentry minsize="1" maxsize="8" metatype="float" extension="float">
          <register name="f6"/>
        </pentry>
        <pentry minsize="1" maxsize="8" metatype="float" extension="float">
          <register name="f7"/>
        </pentry>
        <pentry minsize="1" maxsize="8" metatype="float" extension="float">
          <register name="f8"/>
        </pentry>
        <pentry minsize="1" maxsize="8" metatype="float" extension="float">
          <register name="f9"/>
        </pentry>
        <pentry minsize="1" maxsize="8" metatype="float" extension="float">
          <register name="f10"/>
        </pentry>
        <pentry minsize="1" maxsize="8" metatype="float" extension="float">
          <register name="f11"/>
        </pentry>
        <pentry minsize="1" maxsize="8" metatype="float" extension="float">
          <register name="f12"/>
        </pentry>
        <pentry minsize="1" maxsize="8" metatype="float" extension="float">
          <register name="f13"/>
        </pentry>
        <pentry minsize="1" maxsize="8" extension="sign">
          <register name="r3"/>
        </pentry>
        <pentry minsize="1" maxsize="8" extension="sign">
          <register name="r4"/>
        </pentry>
        <pentry minsize="1" maxsize="8" extension="sign">
          <register name="r5"/>
        </pentry>
        <pentry minsize="1" maxsize="8" extension="sign">
          <register name="r6"/>
        </pentry>
        <pentry minsize="1" maxsize="8" extension="sign">
          <register name="r7"/>
        </pentry>
        <pentry minsize="1" maxsize="8" extension="sign">
          <register name="r8"/>
        </pentry>
        <pentry minsize="1" maxsize="8" extension="sign">
          <register name="r9"/>
        </pentry>
        <pentry minsize="1" maxsize="8" extension="sign">
          <register name="r10"/>
        </pentry>
        <pentry minsize="1" maxsize="500" align="4">
          <addr offset="8" space="stack"/>
        </pentry>
      </input>
      <output>
        <pentry minsize="1" maxsize="8" metatype="float" extension="float">
          <register name="f1"/>
        </pentry>
        <pentry minsize="1" maxsize="8" extension="sign">
          <register name="r3"/>
        </pentry>
      </output>
      <unaffected>
        <register name="r14"/>
        <register name="r15"/>
        <register name="r16"/>
        <register name="r17"/>
        <register name="r18"/>
        <register name="r19"/>
        <register name="r20"/>
        <register name="r21"/>
        <register name="r22"/>
        <register name="r23"/>
        <register name="r24"/>
        <register name="r25"/>
        <register name="r26"/>
        <register name="r27"/>
        <register name="r28"/>
        <register name="r29"/>
        <register name="r30"/>
        <register name="r31"/>
        <register name="r1"/>
        <register name="cr4"/>
      </unaffected>
    </prototype>
  </default_proto>

  <callfixup name="get_pc_thunk_lr">
    <target name="__get_pc_thunk_lr"/>
    <pcode>
      <body><![CDATA[
      LR = inst_dest + 4;
      ]]></body>
    </pcode>
  </callfixup>


  <callfixup name="ppc64_save_restore_regs">
    <target name="_savegpr0_14"/>
    <target name="_savegpr0_15"/>
    <target name="_savegpr0_16"/>
    <target name="_savegpr0_17"/>
    <target name="_savegpr0_18"/>
    <target name="_savegpr0_19"/>
    <target name="_savegpr0_20"/>
    <target name="_savegpr0_21"/>
    <target name="_savegpr0_22"/>
    <target name="_savegpr0_23"/>
    <target name="_savegpr0_24"/>
    <target name="_savegpr0_25"/>
    <target name="_savegpr0_26"/>
    <target name="_savegpr0_27"/>
    <target name="_savegpr0_28"/>
    <target name="_savegpr0_29"/>
    <target name="_savegpr0_30"/>
    <target name="_savegpr0_31"/>
    <target name="_savegpr1_14"/>
    <target name="_savegpr1_15"/>
    <target name="_savegpr1_16"/>
    <target name="_savegpr1_17"/>
    <target name="_savegpr1_18"/>
    <target name="_savegpr1_19"/>
    <target name="_savegpr1_20"/>
    <target name="_savegpr1_21"/>
    <target name="_savegpr1_22"/>
    <target name="_savegpr1_23"/>
    <target name="_savegpr1_24"/>
    <target name="_savegpr1_25"/>
    <target name="_savegpr1_26"/>
    <target name="_savegpr1_27"/>
    <target name="_savegpr1_28"/>
    <target name="_savegpr1_29"/>
    <target name="_savegpr1_30"/>
    <target name="_savegpr1_31"/>
    <target name="_savefpr_14"/>
    <target name="_savefpr_15"/>
    <target name="_savefpr_16"/>
    <target name="_savefpr_17"/>
    <target name="_savefpr_18"/>
    <target name="_savefpr_19"/>
    <target name="_savefpr_20"/>
    <target name="_savefpr_21"/>
    <target name="_savefpr_22"/>
    <target name="_savefpr_23"/>
    <target name="_savefpr_24"/>
    <target name="_savefpr_25"/>
    <target name="_savefpr_26"/>
    <target name="_savefpr_27"/>
    <target name="_savefpr_28"/>
    <target name="_savefpr_29"/>
    <target name="_savefpr_30"/>
    <target name="_savefpr_31"/>
    <target name="_restgpr0_14"/>
    <target name="_restgpr0_15"/>
    <target name="_restgpr0_16"/>
    <target name="_restgpr0_17"/>
    <target name="_restgpr0_18"/>
    <target name="_restgpr0_19"/>
    <target name="_restgpr0_20"/>
    <target name="_restgpr0_21"/>
    <target name="_restgpr0_22"/>
    <target name="_restgpr0_23"/>
    <target name="_restgpr0_24"/>
    <target name="_restgpr0_25"/>
    <target name="_restgpr0_26"/>
    <target name="_restgpr0_27"/>
    <target name="_restgpr0_28"/>
    <target name="_restgpr0_29"/>
    <target name="_restgpr0_30"/>
    <target name="_restgpr0_31"/>
    <target name="_restgpr1_14"/>
    <target name="_restgpr1_15"/>
    <target name="_restgpr1_16"/>
    <target name="_restgpr1_17"/>
    <target name="_restgpr1_18"/>
    <target name="_restgpr1_19"/>
    <target name="_restgpr1_20"/>
    <target name="_restgpr1_21"/>
    <target name="_restgpr1_22"/>
    <target name="_restgpr1_23"/>
    <target name="_restgpr1_24"/>
    <target name="_restgpr1_25"/>
    <target name="_restgpr1_26"/>
    <target name="_restgpr1_27"/>
    <target name="_restgpr1_28"/>
    <target name="_restgpr1_29"/>
    <target name="_restgpr1_30"/>
    <target name="_restgpr1_31"/>
    <target name="_restfpr_14"/>
    <target name="_restfpr_15"/>
    <target name="_restfpr_16"/>
    <target name="_restfpr_17"/>
    <target name="_restfpr_18"/>
    <target name="_restfpr_19"/>
    <target name="_restfpr_20"/>
    <target name="_restfpr_21"/>
    <target name="_restfpr_22"/>
    <target name="_restfpr_23"/>
    <target name="_restfpr_24"/>
    <target name="_restfpr_25"/>
    <target name="_restfpr_26"/>
    <target name="_restfpr_27"/>
    <target name="_restfpr_28"/>
    <target name="_restfpr_29"/>
    <target name="_restfpr_30"/>
    <target name="_restfpr_31"/>
    <target name="_savevr_20"/>
    <target name="_savevr_21"/>
    <target name="_savevr_22"/>
    <target name="_savevr_23"/>
    <target name="_savevr_24"/>
    <target name="_savevr_25"/>
    <target name="_savevr_26"/>
    <target name="_savevr_27"/>
    <target name="_savevr_28"/>
    <target name="_savevr_29"/>
    <target name="_savevr_30"/>
    <target name="_savevr_31"/>
    <target name="_restvr_20"/>
    <target name="_restvr_21"/>
    <target name="_restvr_22"/>
    <target name="_restvr_23"/>
    <target name="_restvr_24"/>
    <target name="_restvr_25"/>
    <target name="_restvr_26"/>
    <target name="_restvr_27"/>
    <target name="_restvr_28"/>
    <target name="_restvr_29"/>
    <target name="_restvr_30"/>
    <target name="_restvr_31"/>
    <pcode>
      <body><![CDATA[
      tmp_save_restore_noop:4 = 0;
      ]]></body>
    </pcode>
  </callfixup>
</compiler_spec>
