<opinions>
	<constraint loader="Executable and Linking Format (ELF)" compilerSpecID="default">
		<!--
		  The low 16 bits of e_flags (EF_PARISC_ARCH) hold the architecture
		  version; the upper bits are flags such as EF_PARISC_TRAPNIL and
		  EF_PARISC_LAZYSWAP that do not affect instruction decoding.
		    0x020b  EFA_PARISC_1_0
		    0x0210  EFA_PARISC_1_1
		    0x0214  EFA_PARISC_2_0 (decoded with the PA 1.1 language, so PA
		            2.0-only instructions do not disassemble)
		-->
		<constraint primary="15" secondary="0b.... .... .... .... 0000 0010 0000 1011" processor="PA-RISC" endian="big" size="32" />
		<constraint primary="15" secondary="0b.... .... .... .... 0000 0010 0001 0000" processor="PA-RISC" endian="big" size="32" />
		<constraint primary="15" secondary="0b.... .... .... .... 0000 0010 0001 0100" processor="PA-RISC" endian="big" size="32" />
	</constraint>
	<constraint loader="System Object Model (SOM)" compilerSpecID="hpux">
		<constraint primary="523" processor="PA-RISC"   endian="big"  size="32" />
		<constraint primary="528" processor="PA-RISC"   endian="big"  size="32" />
		<constraint primary="532" processor="PA-RISC"   endian="big"  size="32" />
	</constraint>
</opinions>
